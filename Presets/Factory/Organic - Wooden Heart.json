{
    "name": "Wooden Heart",
    "category": "Organic",
    "description": "A tuned, hollow wood-block heartbeat: a pitched mallet with a short noise knock, tight and dry. Plays as a rhythmic, melodic percussion layer.",
    "tags": ["organic", "percussion", "wood", "tuned", "dry"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": 3.1,
        "osc1_on": true,
        "osc1_table": "Mallet",
        "osc1_frame": 0.8,
        "osc1_level": 0.9,
        "osc1_pan": -0.1,
        "osc2_on": true,
        "osc2_table": "Clarinet",
        "osc2_frame": 0.3,
        "osc2_level": 0.3,
        "osc2_semi": 7,
        "osc2_pan": 0.12,
        "noise_level": 0.1,
        "noise_type": "White",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 5200,
        "filt1_res": 0.25,
        "env1_attack": 0.001,
        "env1_decay": 0.14,
        "env1_sustain": 0.0,
        "env1_release": 0.07,
        "env1_dcurve": 0.65,
        "env2_attack": 0.001,
        "env2_decay": 0.05,
        "env2_sustain": 0.0,
        "env2_release": 0.03,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.14,
        "fx_reverb_size": 0.4,
        "fx_reverb_decay": 1.4,
        "fx_reverb_damp": 0.55,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.25,
        "fx_delay_tone": 3500,
        "fx_delay_mix": 0.1,
        "fx_delay_sync": "1/8"
