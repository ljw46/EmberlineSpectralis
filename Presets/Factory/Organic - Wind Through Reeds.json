{
    "name": "Wind Through Reeds",
    "category": "Organic",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "Whistling wind through tall reeds: bandpassed noise whose centre drifts on two slow rhythms, with a clarinet whisper underneath. Spooky, spacious and always moving.",
    "tags": ["organic", "wind", "reeds", "noise", "spooky"],
    "macro_names": ["Brightness", "-", "Space", "Width"],
    "parameters": {
        "master_volume": 2.4,
        "noise_level": 0.8,
        "noise_type": "White",
        "osc1_on": true,
        "osc1_table": "Clarinet",
        "osc1_frame": 0.2,
        "osc1_level": 0.25,
        "osc1_unison": 2,
        "osc1_detune": 8,
        "osc1_spread": 0.8,
        "filt1_type": "Bandpass",
        "filt1_cutoff": 1500,
        "filt1_res": 0.5,
        "env1_attack": 1.5,
        "env1_decay": 1.0,
        "env1_sustain": 0.9,
        "env1_release": 2.5,
        "lfo1_rate": 0.15,
        "lfo1_mode": "Free",
        "lfo2_rate": 0.23,
        "lfo2_mode": "Free",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.36,
        "fx_reverb_size": 0.8,
        "fx_reverb_decay": 5.0,
        "fx_reverb_damp": 0.4,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.4,
        "fx_delay_tone": 3000,
        "fx_delay_mix": 0.16,
        "fx_delay_sync": "1/4"
    },
    "modulation": [
        {"source": "LFO 1", "destination": "Filt1 Cutoff", "depth": 0.18},
        {"source": "Perlin", "destination": "Filt1 Cutoff", "depth": 0.12},
        {"source": "LFO 2", "destination": "Noise Level", "depth": 0.12},
        {"source": "Chaos Y", "destination": "Osc1 Pan", "depth": 0.4},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.0},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Mod Wheel", "destination": "Filt1 Res", "depth": 0.25},
        {"source": "Aftertouch", "destination": "Filt1 Cutoff", "depth": 0.15}
    ]
}
