{
    "name": "Ocean Wash",
    "category": "Organic",
    "description": "A slow wash of filtered noise that swells and recedes like surf. Gentle bed for intros and breakdowns.",
    "tags": ["organic", "ocean", "noise", "wash"],
    "macro_names": ["Brightness", "-", "Resonance", "-"],
    "parameters": {
        "master_volume": 2.7,
        "osc1_on": false,
        "osc1_frame": 0.0,
        "osc1_level": 0.0,
        "noise_level": 1.0,
        "noise_type": "Pink",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 900,
        "filt1_res": 0.25,
        "env1_attack": 2.0,
        "env1_decay": 1.0,
        "env1_sustain": 0.9,
        "env1_release": 3.0,
        "env1_acurve": -0.3,
        "lfo1_rate": 0.12,
        "lfo1_mode": "Free",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.4,
        "fx_reverb_size": 0.85,
        "fx_reverb_decay": 6.0,
        "fx_reverb_damp": 0.5
    },
    "modulation": [
        {"source": "LFO 1", "destination": "Filt1 Cutoff", "depth": 0.18},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.0},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.3},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.0}
    ]
}
