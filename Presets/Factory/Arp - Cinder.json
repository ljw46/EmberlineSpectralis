{
    "name": "Cinder",
    "category": "Arp",
    "description": "A crunchy, lo-fi chip-tune arp: video-game and oscillator-chip tables with a gritty edge and a quick decay, saturated just enough to sound like it came from a vintage console.",
    "tags": ["arp", "chiptune", "lofi", "gritty", "retro"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": 2.1,
        "osc1_on": true,
        "osc1_table": "Video Game",
        "osc1_frame": 0.5,
        "osc1_level": 0.75,
        "osc1_pan": -0.12,
        "osc2_on": true,
        "osc2_table": "Chip Oscillators",
        "osc2_frame": 0.4,
        "osc2_level": 0.4,
        "osc2_semi": 12,
        "osc2_pan": 0.16,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 4500,
        "filt1_res": 0.2,
        "env1_attack": 0.001,
        "env1_decay": 0.22,
        "env1_sustain": 0.0,
        "env1_release": 0.12,
        "env1_dcurve": 0.55,
        "env2_attack": 0.001,
        "env2_decay": 0.14,
        "env2_sustain": 0.0,
        "env2_release": 0.08,
        "fx_dist_on": true,
        "fx_dist_type": "Hard",
        "fx_dist_drive": 0.2,
        "fx_dist_tone": 0.55,
        "fx_dist_mix": 0.35,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.3,
        "fx_delay_tone": 4500,
        "fx_delay_mix": 0.16,
        "fx_delay_sync": "1/8",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.14,
        "fx_reverb_size": 0.4,
        "fx_reverb_decay": 1.6,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Osc1 Frame", "depth": -0.25, "bipolar": false},
        {"source": "ENV 2", "destination": "Osc2 Level", "depth": 0.2},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc2 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.2},
        {"source": "Velocity", "destination": "Osc1 Frame", "depth": 0.2},
        {"source": "Mod Wheel", "destination": "Dist Drive", "depth": 0.3},
        {"source": "Aftertouch", "destination": "Osc2 Level", "depth": 0.2}
    ]
}
