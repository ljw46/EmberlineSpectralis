{
    "name": "Rolling Saw",
    "category": "Bass",
    "description": "Classic rolling melodic-house bassline. Filtered saw with a snappy envelope that opens on every note.",
    "tags": ["bass", "rolling", "melodic house"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": -0.1,
        "osc1_on": true,
        "osc1_frame": 0.5,
        "osc1_level": 0.8,
        "osc2_on": true,
        "osc2_frame": 0.5,
        "osc2_level": 0.5,
        "osc2_semi": -12,
        "sub_level": 0.35,
        "sub_wave": "Sine",
        "sub_oct": "-1 Oct",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 450,
        "filt1_res": 0.35,
        "env1_attack": 0.002,
        "env1_decay": 0.25,
        "env1_sustain": 0.55,
        "env1_release": 0.12,
        "env2_attack": 0.001,
        "env2_decay": 0.22,
        "env2_sustain": 0.0,
        "env2_release": 0.2,
        "env2_dcurve": 0.5
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Filt1 Cutoff", "depth": 0.204},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.4},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5}
    ]
}
