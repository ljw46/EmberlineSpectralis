{
    "name": "Concrete Garden",
    "category": "Bass",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A rolling melodic-house bassline: a recorded electric bass for the body, a saw an octave down for bite, and a filter that snaps open on every note. Velocity opens it further.",
    "tags": ["bass", "rolling", "melodic house", "electric bass"],
    "macro_names": ["Brightness", "Morph", "Grit", "Sub"],
    "parameters": {
        "master_volume": -0.6,
        "osc1_on": true,
        "osc1_table": "Electric Bass",
        "osc1_frame": 0.25,
        "osc1_level": 0.85,
        "osc1_pan": -0.1,
        "osc2_on": true,
        "osc2_table": "Classic Morph",
        "osc2_frame": 0.5,
        "osc2_level": 0.35,
        "osc2_semi": -12,
        "osc2_pan": 0.1,
        "sub_level": 0.28,
        "sub_wave": "Sine",
        "sub_oct": "-1 Oct",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 560,
        "filt1_res": 0.3,
        "filt1_drive": 0.12,
        "env1_attack": 0.002,
        "env1_decay": 0.3,
        "env1_sustain": 0.6,
        "env1_release": 0.12,
        "env2_attack": 0.001,
        "env2_decay": 0.24,
        "env2_sustain": 0.0,
        "env2_release": 0.2,
        "env2_dcurve": 0.5,
        "fx_dist_on": true,
        "fx_dist_type": "Soft",
        "fx_dist_drive": 0.22,
        "fx_dist_tone": 0.55,
        "fx_dist_mix": 0.32,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.05,
        "fx_reverb_size": 0.3,
        "fx_reverb_decay": 1.0,
        "fx_reverb_damp": 0.7
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Filt1 Cutoff", "depth": 0.205},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.45},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Dist Drive", "depth": 0.5},
        {"source": "Macro 4", "destination": "Sub Level", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.18},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.28},
        {"source": "Aftertouch", "destination": "Dist Mix", "depth": 0.12}
    ]
}
