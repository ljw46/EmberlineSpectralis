{
    "name": "Pebble Beach",
    "category": "Arp",
    "description": "A smooth, wooden marimba arp with a stereo-spread pair of tones an octave apart - round and rhythmic, like pebbles dropped one at a time into still water.",
    "tags": ["arp", "marimba", "wooden", "organic house", "round"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": 3.6,
        "osc1_on": true,
        "osc1_table": "Mallet",
        "osc1_frame": 0.6,
        "osc1_level": 0.8,
        "osc1_pan": -0.2,
        "osc2_on": true,
        "osc2_table": "Mallet",
        "osc2_frame": 0.3,
        "osc2_level": 0.45,
        "osc2_semi": 12,
        "osc2_pan": 0.2,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 5000,
        "filt1_res": 0.12,
        "env1_attack": 0.001,
        "env1_decay": 0.3,
        "env1_sustain": 0.0,
        "env1_release": 0.18,
        "env1_dcurve": 0.5,
        "env2_attack": 0.001,
        "env2_decay": 0.12,
        "env2_sustain": 0.0,
        "env2_release": 0.08,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.4,
        "fx_delay_tone": 4500,
        "fx_delay_mix": 0.26,
        "fx_delay_sync": "1/8.",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.24,
        "fx_reverb_size": 0.55,
        "fx_reverb_decay": 2.6,
        "fx_reverb_damp": 0.45
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Osc2 Level", "depth": 0.3},
        {"source": "Perlin", "destination": "Osc2 Pan", "depth": 0.15},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.45},
        {"source": "Macro 2", "destination": "Osc2 Frame", "depth": 0.45},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.22},
        {"source": "Velocity", "destination": "Osc1 Frame", "depth": 0.2},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Aftertouch", "destination": "Osc2 Level", "depth": 0.2}
    ]
}
