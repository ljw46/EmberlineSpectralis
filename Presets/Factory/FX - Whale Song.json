        "osc1_table": "Theremin",
        "osc1_frame": 0.2,
        "osc1_level": 0.7,
        "osc1_unison": 2,
        "osc1_detune": 9,
        "osc1_spread": 0.9,
        "osc1_pan": -0.2,
        "osc2_on": true,
        "osc2_table": "Human Voice",
        "osc2_frame": 0.1,
        "osc2_level": 0.5,
        "osc2_unison": 2,
        "osc2_detune": 7,
        "osc2_spread": 0.5,
        "osc2_semi": -12,
        "osc2_pan": 0.2,
        "filt1_type": "Lowpass",
