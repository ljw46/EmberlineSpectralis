{
    "name": "FM Growl Bass",
    "category": "Bass",
    "description": "Gritty FM bass: the 1:2 FM table with a synced LFO sweeping the modulation index. Aggressive but tight.",
    "tags": ["bass", "fm", "growl", "wavetable", "synced"],
    "macro_names": ["Brightness", "Index", "Resonance", "-"],
    "parameters": {
        "master_volume": -4.3,
        "osc1_table": "FM 1:2",
        "osc1_on": true,
        "osc1_frame": 0.2,
        "osc1_level": 0.85,
        "sub_level": 0.4,
        "sub_wave": "Sine",
        "sub_oct": "-1 Oct",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 2500,
        "filt1_res": 0.2,
        "env1_attack": 0.002,
        "env1_decay": 0.3,
        "env1_sustain": 0.9,
        "env1_release": 0.12,
        "lfo1_sync": "1/8",
        "lfo1_mode": "Free",
        "fx_dist_on": true,
        "fx_dist_type": "Soft",
        "fx_dist_drive": 0.25,
        "fx_dist_tone": 0.5,
        "fx_dist_mix": 0.4
    },
    "modulation": [
        {"source": "LFO 1", "destination": "Osc1 Frame", "depth": 0.18},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.2},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.0}
    ],
    "lfo_shapes": {"lfo1": "triangle"}
}
