{
    "name": "Ocean Breath",
    "category": "Organic",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A slow tide of filtered noise that swells and recedes, with a faint tuned hum buried underneath. A natural bed for intros and breakdowns that never loops.",
    "tags": ["organic", "ocean", "noise", "wash", "ambient"],
    "macro_names": ["Brightness", "-", "Space", "Width"],
    "parameters": {
        "master_volume": 3.7,
        "noise_level": 1.0,
        "noise_type": "Pink",
        "osc1_on": true,
        "osc1_table": "Theremin",
        "osc1_frame": 0.15,
        "osc1_level": 0.2,
        "osc1_unison": 2,
        "osc1_detune": 8,
        "osc1_spread": 0.8,
        "osc1_pan": -0.1,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 900,
        "filt1_res": 0.22,
        "env1_attack": 2.2,
        "env1_decay": 1.0,
        "env1_sustain": 0.9,
        "env1_release": 3.5,
        "env1_acurve": -0.3,
        "lfo1_rate": 0.09,
        "lfo1_mode": "Free",
        "lfo2_rate": 0.05,
        "lfo2_mode": "Free",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.4,
        "fx_reverb_size": 0.85,
        "fx_reverb_decay": 6.0,
        "fx_reverb_damp": 0.5,
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.2,
        "fx_chorus_rate": 0.2,
        "fx_chorus_depth": 0.5
    },
    "modulation": [
        {"source": "LFO 1", "destination": "Filt1 Cutoff", "depth": 0.2},
        {"source": "LFO 2", "destination": "Noise Level", "depth": 0.2},
        {"source": "Perlin", "destination": "Osc1 Level", "depth": 0.15},
        {"source": "Chaos X", "destination": "Osc1 Pan", "depth": 0.3},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.0},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Mod Wheel", "destination": "Noise Level", "depth": 0.2},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.15}
    ]
}
