{
    "name": "Satin Fold",
    "category": "Lead",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A buzzy West-Coast lead: a sine folded harder and harder by Macro 2, with a warm sub-octave under it so it never gets thin. Smooth when played soft, rich when pushed.",
    "tags": ["lead", "fold", "west coast", "buzzy"],
    "macro_names": ["Brightness", "Fold", "Space", "Width"],
    "parameters": {
        "master_volume": -0.9,
        "osc1_on": true,
        "osc1_table": "Sine Fold",
        "osc1_frame": 0.2,
        "osc1_level": 0.8,
        "osc1_unison": 2,
        "osc1_detune": 6,
        "osc1_spread": 0.5,
        "osc1_pan": -0.1,
        "osc2_on": true,
        "osc2_table": "Bass Weight",
        "osc2_frame": 0.3,
        "osc2_level": 0.4,
        "osc2_semi": -12,
        "osc2_pan": 0.1,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 7000,
        "filt1_res": 0.15,
        "env1_attack": 0.01,
        "env1_decay": 0.3,
        "env1_sustain": 0.85,
        "env1_release": 0.35,
        "lfo2_rate": 5.2,
        "lfo2_mode": "Free",
        "fx_delay_on": true,
        "fx_delay_feedback": 0.35,
        "fx_delay_tone": 5000,
        "fx_delay_mix": 0.22,
        "fx_delay_sync": "1/8.",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.22,
        "fx_reverb_size": 0.55,
        "fx_reverb_decay": 2.6,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "Velocity", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Aftertouch", "destination": "Osc1 Frame", "depth": 0.25},
        {"source": "LFO 2", "destination": "Osc1 Fine", "depth": 0.025},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.45},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.6},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.18}
    ]
}
