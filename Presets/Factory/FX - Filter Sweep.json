{
    "name": "Filter Sweep",
    "category": "FX",
    "description": "A long filter sweep across a rich saw stack. Automate Macro 1 or let the LFO do it.",
    "tags": ["fx", "sweep", "filter", "transition"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": -0.3,
        "osc1_on": true,
        "osc1_frame": 0.5,
        "osc1_level": 0.65,
        "osc1_unison": 5,
        "osc1_detune": 18,
        "osc1_spread": 0.9,
        "osc2_on": true,
        "osc2_frame": 0.5,
        "osc2_level": 0.45,
        "osc2_unison": 3,
        "osc2_detune": 14,
        "osc2_spread": 0.5,
        "osc2_semi": -12,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 500,
        "filt1_res": 0.5,
        "env1_attack": 0.1,
        "env1_decay": 1.0,
        "env1_sustain": 1.0,
        "env1_release": 1.5,
        "lfo1_rate": 0.12,
        "lfo1_mode": "Free",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.25,
        "fx_reverb_size": 0.65,
        "fx_reverb_decay": 3.0,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "LFO 1", "destination": "Filt1 Cutoff", "depth": 0.35},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.2},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.4}
    ],
    "lfo_shapes": {"lfo1": "triangle"}
}
