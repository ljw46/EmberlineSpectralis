{
    "name": "Whistle Lead",
    "category": "Lead",
    "description": "High, thin, almost whistled sine lead. Use in the upper octaves for airy top lines.",
    "tags": ["lead", "whistle", "thin", "high"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": -6.3,
        "osc1_on": true,
        "osc1_frame": 0.0,
        "osc1_level": 0.85,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 9000,
        "filt1_res": 0.05,
        "env1_attack": 0.03,
        "env1_decay": 0.3,
        "env1_sustain": 0.9,
        "env1_release": 0.3,
        "lfo2_rate": 5.8,
        "lfo2_mode": "Free",
        "fx_delay_on": true,
        "fx_delay_feedback": 0.35,
        "fx_delay_tone": 5000,
        "fx_delay_mix": 0.25,
        "fx_delay_sync": "1/8.",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.3,
        "fx_reverb_size": 0.7,
        "fx_reverb_decay": 3.5,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "LFO 2", "destination": "Osc1 Fine", "depth": 0.05},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.1},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.1},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.0}
    ]
}
