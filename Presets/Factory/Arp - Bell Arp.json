{
    "name": "Bell Arp",
    "category": "Arp",
    "description": "Bell-toned arp voice with a metallic overtone. Pretty over minor chord progressions.",
    "tags": ["arp", "bell", "metallic", "pretty"],
    "macro_names": ["Brightness", "Tone", "-", "Shimmer"],
    "parameters": {
        "master_volume": -0.6,
        "osc1_on": true,
        "osc1_frame": 0.25,
        "osc1_level": 0.7,
        "osc2_on": true,
        "osc2_frame": 0.0,
        "osc2_level": 0.35,
        "osc2_semi": 19,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 6500,
        "filt1_res": 0.1,
        "env1_attack": 0.001,
        "env1_decay": 0.5,
        "env1_sustain": 0.0,
        "env1_release": 0.4,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.45,
        "fx_delay_tone": 5500,
        "fx_delay_mix": 0.3,
        "fx_delay_sync": "1/8.",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.3,
        "fx_reverb_size": 0.7,
        "fx_reverb_decay": 4.0,
        "fx_reverb_damp": 0.3,
        "osc1_table": "FM 1:5 Bell"
    },
    "modulation": [
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.3},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.2},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.3}
    ]
