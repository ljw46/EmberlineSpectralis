{
    "name": "Pulse Arp",
    "category": "Arp",
    "description": "Pulse-wave arp whose width wobbles via phase distortion. Hollow, buzzy and retro.",
    "tags": ["arp", "pulse", "phase", "retro"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": 1.7,
        "osc1_on": true,
        "osc1_frame": 0.15,
        "osc1_level": 0.75,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 3000,
        "filt1_res": 0.25,
        "env1_attack": 0.001,
        "env1_decay": 0.2,
        "env1_sustain": 0.0,
        "env1_release": 0.12,
        "env1_dcurve": 0.5,
        "lfo1_rate": 0.7,
        "lfo1_mode": "Free",
        "fx_delay_on": true,
        "fx_delay_feedback": 0.35,
        "fx_delay_tone": 5000,
        "fx_delay_mix": 0.2,
        "fx_delay_sync": "1/8",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.15,
        "fx_reverb_size": 0.4,
        "fx_reverb_decay": 1.8,
        "fx_reverb_damp": 0.4,
        "osc1_table": "Pulse Width"
    },
    "modulation": [
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.3},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.3},
        {"source": "LFO 1", "destination": "Osc1 Frame", "depth": 0.22}
    ]
}
