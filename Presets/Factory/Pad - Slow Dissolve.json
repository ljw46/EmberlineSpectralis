{
    "name": "Slow Dissolve",
    "category": "Pad",
    "description": "A random-spectrum pad that morphs between four different timbres and then does it again somewhere else. Nothing here repeats - Perlin and the Lorenz attractor take turns steering.",
    "tags": ["pad", "random", "evolving", "organic", "generative"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": 2.4,
        "osc1_on": true,
        "osc1_table": "Noise Morph",
        "osc1_frame": 0.3,
        "osc1_level": 0.65,
        "osc1_unison": 4,
        "osc1_detune": 13,
        "osc1_spread": 0.9,
        "osc1_pan": -0.2,
        "osc2_on": true,
        "osc2_table": "Noise Morph",
        "osc2_frame": 0.7,
        "osc2_level": 0.5,
        "osc2_unison": 3,
        "osc2_detune": 11,
        "osc2_spread": 0.8,
        "osc2_semi": 7,
        "osc2_pan": 0.2,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 3200,
        "filt1_res": 0.22,
        "env1_attack": 1.5,
        "env1_decay": 1.0,
        "env1_sustain": 0.85,
        "env1_release": 2.8,
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.28,
        "fx_chorus_rate": 0.28,
        "fx_chorus_depth": 0.5,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.45,
        "fx_reverb_size": 0.85,
        "fx_reverb_decay": 6.5,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "Perlin", "destination": "Osc1 Frame", "depth": 0.45},
        {"source": "Chaos X", "destination": "Osc2 Frame", "depth": 0.4},
        {"source": "Chaos Y", "destination": "Filt1 Cutoff", "depth": 0.14},
        {"source": "Chaos Z", "destination": "Osc1 Pan", "depth": 0.4},
        {"source": "Perlin", "destination": "Osc2 Pan", "depth": -0.4},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc2 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.08},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Aftertouch", "destination": "Osc2 Frame", "depth": 0.2}
    ]
}
