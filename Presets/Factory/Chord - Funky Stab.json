{
    "name": "Funky Stab",
    "category": "Chord",
    "description": "Quacky stab with a sync-warp snap and bandpass character. Slaps in a funk-house groove.",
    "tags": ["stab", "funky", "sync", "quack"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": -0.1,
        "osc1_on": true,
        "osc1_frame": 0.5,
        "osc1_level": 0.8,
        "osc1_warp_mode": "Sync",
        "osc1_warp_amt": 0.1,
        "filt1_type": "Bandpass",
        "filt1_cutoff": 1500,
        "filt1_res": 0.4,
        "env1_attack": 0.001,
        "env1_decay": 0.22,
        "env1_sustain": 0.0,
        "env1_release": 0.1,
        "env1_dcurve": 0.6,
        "env2_attack": 0.001,
        "env2_decay": 0.15,
        "env2_sustain": 0.0,
        "env2_release": 0.1,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.3,
        "fx_delay_tone": 4500,
        "fx_delay_mix": 0.2,
        "fx_delay_sync": "1/8",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.12,
        "fx_reverb_size": 0.4,
        "fx_reverb_decay": 1.6,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Osc1 Warp", "depth": 0.35},
        {"source": "ENV 2", "destination": "Filt1 Cutoff", "depth": 0.155},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.4},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5}
    ]
}
