{
    "name": "Moonlight",
    "category": "Pad",
    "description": "Soft, glowing triangle pad with a touch of octave shimmer. Calm and nocturnal.",
    "tags": ["pad", "moonlight", "soft", "calm"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": -2.5,
        "osc1_on": true,
        "osc1_frame": 0.27,
        "osc1_level": 0.7,
        "osc1_unison": 3,
        "osc1_detune": 10,
        "osc1_spread": 0.8,
        "osc2_on": true,
        "osc2_frame": 0.0,
        "osc2_level": 0.35,
        "osc2_semi": 12,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 3000,
        "filt1_res": 0.1,
        "env1_attack": 1.0,
        "env1_decay": 1.0,
        "env1_sustain": 0.85,
        "env1_release": 2.0,
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.3,
        "fx_chorus_rate": 0.3,
        "fx_chorus_depth": 0.5,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.4,
        "fx_reverb_size": 0.8,
        "fx_reverb_decay": 6.0,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.2},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5}
    ]
}
