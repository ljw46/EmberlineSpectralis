{
    "name": "Warm Machine",
    "category": "Bass",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A digital bass table under a square an octave down, with a gentle envelope sweep - analogue-flavoured warmth from a very digital recipe.",
    "tags": ["bass", "digital", "warm", "machine"],
    "macro_names": ["Brightness", "Morph", "Grit", "Sub"],
    "parameters": {
        "master_volume": -2.5,
        "osc1_on": true,
        "osc1_table": "Digital Bass",
        "osc1_frame": 0.4,
        "osc1_level": 0.8,
        "osc1_pan": -0.08,
        "osc2_on": true,
        "osc2_table": "Pulse Width",
        "osc2_frame": 0.04,
        "osc2_level": 0.5,
        "osc2_semi": -12,
        "osc2_pan": 0.08,
        "sub_level": 0.25,
        "sub_wave": "Sine",
        "sub_oct": "-1 Oct",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 700,
        "filt1_res": 0.25,
        "filt1_drive": 0.12,
        "env1_attack": 0.003,
        "env1_decay": 0.35,
        "env1_sustain": 0.8,
        "env1_release": 0.14,
        "env2_attack": 0.001,
        "env2_decay": 0.3,
        "env2_sustain": 0.0,
        "env2_release": 0.2,
        "fx_dist_on": true,
        "fx_dist_type": "Soft",
        "fx_dist_drive": 0.25,
        "fx_dist_tone": 0.5,
        "fx_dist_mix": 0.35
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Filt1 Cutoff", "depth": 0.17},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.45},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Dist Drive", "depth": 0.5},
        {"source": "Macro 4", "destination": "Sub Level", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.18},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.28},
        {"source": "Aftertouch", "destination": "Dist Mix", "depth": 0.12}
    ]
}
