{
    "name": "Low Tide",
    "category": "Bass",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A hollow, swaying bass: a pulse wave and a digital bass table, with a half-note LFO that lets the filter wash in and out like water.",
    "tags": ["bass", "hollow", "synced", "groove"],
    "macro_names": ["Brightness", "Morph", "Grit", "Sub"],
    "parameters": {
        "master_volume": -2.7,
        "osc1_on": true,
        "osc1_table": "Digital Bass",
        "osc1_frame": 0.3,
        "osc1_level": 0.8,
        "osc2_on": true,
        "osc2_table": "Pulse Width",
        "osc2_frame": 0.12,
        "osc2_level": 0.45,
        "osc2_semi": -12,
        "osc2_pan": 0.12,
        "sub_level": 0.25,
        "sub_wave": "Sine",
        "sub_oct": "-1 Oct",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 500,
        "filt1_res": 0.38,
        "filt1_drive": 0.1,
        "env1_attack": 0.003,
        "env1_decay": 0.3,
        "env1_sustain": 0.85,
        "env1_release": 0.15,
        "lfo1_sync": "1/2",
        "lfo1_mode": "Free",
        "lfo2_rate": 0.4,
        "lfo2_mode": "Free",
        "fx_dist_on": true,
        "fx_dist_type": "Soft",
        "fx_dist_drive": 0.2,
        "fx_dist_tone": 0.5,
        "fx_dist_mix": 0.3
    },
    "modulation": [
        {"source": "LFO 1", "destination": "Filt1 Cutoff", "depth": 0.18},
        {"source": "LFO 2", "destination": "Osc2 Frame", "depth": 0.2},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.45},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Dist Drive", "depth": 0.5},
        {"source": "Macro 4", "destination": "Sub Level", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.18},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.28},
        {"source": "Aftertouch", "destination": "Dist Mix", "depth": 0.12}
    ],
    "lfo_shapes": {"lfo1": "sine"}
}
