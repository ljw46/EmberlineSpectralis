{
    "name": "Riverside Flute",
    "category": "Organic",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A sustained breathy flute with a trace of wind and a slow vibrato that builds with aftertouch. Open-air, warm, and slightly imperfect in all the right ways.",
    "tags": ["organic", "flute", "breathy", "sustained", "natural"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": -3.9,
        "osc1_on": true,
        "osc1_table": "Flute",
        "osc1_frame": 0.3,
        "osc1_level": 0.85,
        "osc1_unison": 2,
        "osc1_detune": 4,
        "osc1_spread": 0.5,
        "osc1_pan": -0.12,
        "osc2_on": true,
        "osc2_table": "Clarinet",
        "osc2_frame": 0.15,
        "osc2_level": 0.2,
        "osc2_semi": 12,
        "osc2_pan": 0.14,
        "noise_level": 0.05,
        "noise_type": "Pink",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 5500,
        "filt1_res": 0.1,
        "env1_attack": 0.08,
        "env1_decay": 0.3,
        "env1_sustain": 0.88,
        "env1_release": 0.5,
        "lfo2_rate": 4.5,
        "lfo2_mode": "Free",
        "lfo1_rate": 0.12,
        "lfo1_mode": "Free",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.34,
        "fx_reverb_size": 0.7,
        "fx_reverb_decay": 3.6,
        "fx_reverb_damp": 0.4,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.32,
        "fx_delay_tone": 3200,
        "fx_delay_mix": 0.16,
        "fx_delay_sync": "1/4"
    },
    "modulation": [
        {"source": "LFO 2", "destination": "Osc1 Fine", "depth": 0.012},
        {"source": "Aftertouch", "destination": "Osc1 Fine", "depth": 0.035},
        {"source": "LFO 1", "destination": "Noise Level", "depth": 0.03},
        {"source": "Perlin", "destination": "Osc1 Frame", "depth": 0.2},
        {"source": "Mod Wheel", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.45},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.2}
    ]
}
