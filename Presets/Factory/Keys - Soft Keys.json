{
    "name": "Soft Keys",
    "category": "Keys",
    "description": "Very soft, rounded keys. Sine-heavy and unobtrusive, good underneath vocals.",
    "tags": ["keys", "soft", "sine", "gentle"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": -3.5,
        "osc1_on": true,
        "osc1_frame": 0.05,
        "osc1_level": 0.8,
        "osc1_unison": 2,
        "osc1_detune": 5,
        "osc1_spread": 0.5,
        "osc2_on": true,
        "osc2_frame": 0.2,
        "osc2_level": 0.25,
        "osc2_semi": 12,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 2500,
        "filt1_res": 0.1,
        "env1_attack": 0.006,
        "env1_decay": 0.9,
        "env1_sustain": 0.3,
        "env1_release": 0.5,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.25,
        "fx_reverb_size": 0.6,
        "fx_reverb_decay": 3.0,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.3},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.2},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.2}
    ]
}
