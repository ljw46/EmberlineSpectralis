{
    "name": "Dream Pad",
    "category": "Pad",
    "description": "Washed-out dreamy pad with delay and reverb woven into the sound.",
    "tags": ["pad", "dreamy", "washed", "delay"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": -0.9,
        "osc1_on": true,
        "osc1_frame": 0.38,
        "osc1_level": 0.65,
        "osc1_unison": 4,
        "osc1_detune": 14,
        "osc1_spread": 0.9,
        "osc2_on": true,
        "osc2_frame": 0.15,
        "osc2_level": 0.45,
        "osc2_unison": 2,
        "osc2_detune": 9,
        "osc2_spread": 0.5,
        "osc2_semi": 12,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 3000,
        "filt1_res": 0.15,
        "env1_attack": 1.0,
        "env1_decay": 1.0,
        "env1_sustain": 0.85,
        "env1_release": 2.2,
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.4,
        "fx_chorus_rate": 0.3,
        "fx_chorus_depth": 0.6,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.5,
        "fx_delay_tone": 4500,
        "fx_delay_mix": 0.3,
        "fx_delay_sync": "1/4",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.45,
        "fx_reverb_size": 0.85,
        "fx_reverb_decay": 7.0,
        "fx_reverb_damp": 0.35
    },
    "modulation": [
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.2},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5}
    ]
}
