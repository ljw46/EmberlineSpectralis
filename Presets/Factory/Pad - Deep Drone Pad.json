{
    "name": "Deep Drone Pad",
    "category": "Pad",
    "description": "Low, sustained drone pad with a sub underneath. For minimal, hypnotic sections.",
    "tags": ["pad", "drone", "deep", "sub"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": -9.2,
        "osc1_on": true,
        "osc1_frame": 0.35,
        "osc1_level": 0.65,
        "osc1_unison": 3,
        "osc1_detune": 9,
        "osc1_spread": 0.6,
        "osc2_on": true,
        "osc2_frame": 0.1,
        "osc2_level": 0.5,
        "osc2_semi": -12,
        "sub_level": 0.4,
        "sub_wave": "Sine",
        "sub_oct": "-1 Oct",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 650,
        "filt1_res": 0.2,
        "env1_attack": 1.5,
        "env1_decay": 1.0,
        "env1_sustain": 0.9,
        "env1_release": 2.5,
        "lfo1_rate": 0.06,
        "lfo1_mode": "Free",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.3,
        "fx_reverb_size": 0.7,
        "fx_reverb_decay": 4.5,
        "fx_reverb_damp": 0.6
    },
    "modulation": [
        {"source": "LFO 1", "destination": "Filt1 Cutoff", "depth": 0.08},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.3},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.3},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.3}
    ]
}
