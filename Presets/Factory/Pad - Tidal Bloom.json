{
    "name": "Tidal Bloom",
    "category": "Pad",
    "description": "A pad that is built harmonic by harmonic: the additive table fills in as a slow LFO swells, while a comb-filtered layer ripples through the stereo field like a flanger frozen in water.",
    "tags": ["pad", "additive", "evolving", "flanger", "breathing"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": 0.9,
        "osc1_on": true,
        "osc1_table": "Additive Build",
        "osc1_frame": 0.2,
        "osc1_level": 0.65,
        "osc1_unison": 4,
        "osc1_detune": 12,
        "osc1_spread": 0.9,
        "osc1_pan": -0.2,
        "osc2_on": true,
        "osc2_table": "Comb Phaser",
        "osc2_frame": 0.3,
        "osc2_level": 0.5,
        "osc2_unison": 3,
        "osc2_detune": 10,
        "osc2_spread": 0.8,
        "osc2_semi": 7,
        "osc2_pan": 0.2,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 5000,
        "filt1_res": 0.12,
        "env1_attack": 1.3,
        "env1_decay": 1.0,
        "env1_sustain": 0.85,
        "env1_release": 2.6,
        "lfo1_rate": 0.06,
        "lfo1_mode": "Free",
        "lfo2_rate": 0.09,
        "lfo2_mode": "Free",
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.3,
        "fx_chorus_rate": 0.25,
        "fx_chorus_depth": 0.55,
        "fx_chorus_mode": "Flanger",
        "fx_chorus_feedback": 0.3,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.4,
        "fx_reverb_size": 0.8,
        "fx_reverb_decay": 6.0,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "LFO 1", "destination": "Osc1 Frame", "depth": 0.5, "bipolar": false},
        {"source": "LFO 2", "destination": "Osc2 Frame", "depth": 0.5, "bipolar": false},
        {"source": "Perlin", "destination": "Filt1 Cutoff", "depth": 0.1},
        {"source": "Chaos X", "destination": "Osc2 Pan", "depth": 0.35},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc2 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.1},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Aftertouch", "destination": "Osc2 Frame", "depth": 0.2}
    ],
    "lfo_shapes": {"lfo1": "sine", "lfo2": "triangle"}
}
