{
    "name": "Rain On Leaves",
    "category": "Organic",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A fine, tactile patter of crackle-noise rain with a faint, high bell tone floating above it. Light, fresh and lo-fi - drop it under anything for instant atmosphere.",
    "tags": ["organic", "rain", "crackle", "lofi", "atmosphere"],
    "macro_names": ["Brightness", "Bell", "Space", "Width"],
    "parameters": {
        "master_volume": 0.8,
        "noise_level": 1.0,
        "noise_type": "Crackle",
        "osc1_on": true,
        "osc1_table": "FM 1:5 Bell",
        "osc1_frame": 0.2,
        "osc1_level": 0.25,
        "osc1_unison": 2,
        "osc1_detune": 6,
        "osc1_spread": 0.9,
        "osc1_semi": 12,
        "filt1_type": "Highpass",
        "filt1_cutoff": 600,
        "filt1_res": 0.12,
        "env1_attack": 0.4,
        "env1_decay": 1.0,
        "env1_sustain": 0.9,
        "env1_release": 1.5,
        "lfo1_rate": 0.1,
        "lfo1_mode": "Free",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.34,
        "fx_reverb_size": 0.75,
        "fx_reverb_decay": 3.8,
        "fx_reverb_damp": 0.4,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.4,
        "fx_delay_tone": 4500,
        "fx_delay_mix": 0.2,
        "fx_delay_sync": "1/8."
    },
    "modulation": [
        {"source": "LFO 1", "destination": "Noise Level", "depth": 0.15},
        {"source": "Perlin", "destination": "Osc1 Level", "depth": 0.15},
        {"source": "Perlin", "destination": "Osc1 Frame", "depth": 0.3},
        {"source": "Chaos Z", "destination": "Osc1 Pan", "depth": 0.4},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Mod Wheel", "destination": "Noise Level", "depth": 0.2},
        {"source": "Velocity", "destination": "Osc1 Level", "depth": 0.2}
    ]
}
