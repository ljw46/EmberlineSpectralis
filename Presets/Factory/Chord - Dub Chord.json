{
    "name": "Dub Chord",
    "category": "Chord",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A soft, filtered chord thrown into a huge feedback echo and a deep reverb, the echo darkening with every repeat. Play one chord and let it dissolve - pure dub techno.",
    "tags": ["stab", "dub", "techno", "echo", "deep"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": 0.9,
        "osc1_on": true,
        "osc1_table": "Pluck Position",
        "osc1_frame": 0.4,
        "osc1_level": 0.75,
        "osc1_unison": 3,
        "osc1_detune": 9,
        "osc1_spread": 0.7,
        "osc1_pan": -0.14,
        "osc2_on": true,
        "osc2_table": "FM 1:1",
        "osc2_frame": 0.1,
        "osc2_level": 0.4,
        "osc2_unison": 2,
        "osc2_detune": 7,
        "osc2_spread": 0.5,
        "osc2_semi": 7,
        "osc2_pan": 0.16,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 1400,
        "filt1_res": 0.3,
        "filt1_drive": 0.1,
        "env1_attack": 0.003,
        "env1_decay": 0.35,
        "env1_sustain": 0.0,
        "env1_release": 0.3,
        "env1_dcurve": 0.5,
        "env2_attack": 0.001,
        "env2_decay": 0.25,
        "env2_sustain": 0.0,
        "env2_release": 0.2,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.66,
        "fx_delay_tone": 2400,
        "fx_delay_mix": 0.5,
        "fx_delay_sync": "1/4.",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.34,
        "fx_reverb_size": 0.8,
        "fx_reverb_decay": 6.0,
        "fx_reverb_damp": 0.6,
        "fx_slot1": "Delay",
        "fx_slot2": "Reverb",
        "fx_slot3": "Distortion",
        "fx_slot4": "Chorus/Flanger"
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Filt1 Cutoff", "depth": 0.164},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.45},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Mod Wheel", "destination": "Delay Feedback", "depth": 0.25},
        {"source": "Aftertouch", "destination": "Delay Mix", "depth": 0.2},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.2}
    ]
}
