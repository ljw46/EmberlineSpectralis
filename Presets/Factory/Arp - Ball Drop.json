        "osc1_table": "Mallet",
        "osc1_frame": 0.55,
        "osc1_level": 0.8,
        "osc1_pan": -0.14,
        "osc2_on": true,
        "osc2_table": "Glass Harmonics",
        "osc2_frame": 0.4,
