{
    "name": "Flute Lead",
    "category": "Lead",
    "description": "Breathy, flute-like sine lead with a little pink noise and slow vibrato.",
    "tags": ["lead", "flute", "breathy", "organic"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": -5.0,
        "osc1_on": true,
        "osc1_frame": 0.05,
        "osc1_level": 0.85,
        "osc2_on": true,
        "osc2_frame": 0.2,
        "osc2_level": 0.2,
        "osc2_semi": 12,
        "noise_level": 0.04,
        "noise_type": "Pink",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 5000,
        "filt1_res": 0.1,
        "env1_attack": 0.05,
        "env1_decay": 0.3,
        "env1_sustain": 0.85,
        "env1_release": 0.3,
        "lfo2_rate": 4.6,
        "lfo2_mode": "Free",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.25,
        "fx_reverb_size": 0.6,
        "fx_reverb_decay": 2.6,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "LFO 2", "destination": "Osc1 Fine", "depth": 0.04},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.3},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.2},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.0}
    ]
}
