{
    "name": "Short Arp",
    "category": "Arp",
    "description": "Tight saw arp voice. Very short decay so fast arpeggios stay clean and rhythmic.",
    "tags": ["arp", "short", "tight", "melodic house"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": 4.6,
        "osc1_on": true,
        "osc1_frame": 0.5,
        "osc1_level": 0.8,
        "osc1_unison": 2,
        "osc1_detune": 8,
        "osc1_spread": 0.5,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 1800,
        "filt1_res": 0.3,
        "env1_attack": 0.001,
        "env1_decay": 0.16,
        "env1_sustain": 0.0,
        "env1_release": 0.1,
        "env1_dcurve": 0.6,
        "env2_attack": 0.001,
        "env2_decay": 0.12,
        "env2_sustain": 0.0,
        "env2_release": 0.1,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.4,
        "fx_delay_tone": 5000,
        "fx_delay_mix": 0.25,
        "fx_delay_sync": "1/8.",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.15,
        "fx_reverb_size": 0.45,
        "fx_reverb_decay": 2.0,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Filt1 Cutoff", "depth": 0.236},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.4},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5}
    ]
}
