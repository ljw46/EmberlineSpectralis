{
    "name": "Pan Flute",
    "category": "Organic",
    "description": "Pan-pipe tone: a hollow, breathy wave with a soft attack puff and a sustained airy body.",
    "tags": ["organic", "pan flute", "hollow", "wind"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": -3.7,
        "osc1_on": true,
        "osc1_frame": 0.08,
        "osc1_level": 0.75,
        "noise_level": 0.1,
        "noise_type": "Pink",
        "filt1_type": "Bandpass",
        "filt1_cutoff": 1800,
        "filt1_res": 0.25,
        "env1_attack": 0.05,
        "env1_decay": 0.3,
        "env1_sustain": 0.85,
        "env1_release": 0.3,
        "lfo2_rate": 4.8,
        "lfo2_mode": "Free",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.3,
        "fx_reverb_size": 0.7,
        "fx_reverb_decay": 3.5,
        "fx_reverb_damp": 0.4,
        "osc1_table": "Odd to Even"
    },
    "modulation": [
        {"source": "LFO 2", "destination": "Osc1 Fine", "depth": 0.03},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.3},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.3},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.0}
    ]
}
