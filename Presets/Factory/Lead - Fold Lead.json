{
    "name": "Fold Lead",
    "category": "Lead",
    "description": "Wavefolder lead: Macro 2 folds the sine harder for a rich, buzzy, West-Coast lead.",
    "tags": ["lead", "fold", "west coast", "wavetable"],
    "macro_names": ["Brightness", "Fold", "Resonance", "Width"],
    "parameters": {
        "master_volume": -3.7,
        "osc1_table": "Sine Fold",
        "osc1_on": true,
        "osc1_frame": 0.3,
        "osc1_level": 0.85,
        "osc1_unison": 2,
        "osc1_detune": 7,
        "osc1_spread": 0.5,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 7000,
        "filt1_res": 0.15,
        "env1_attack": 0.01,
        "env1_decay": 0.3,
        "env1_sustain": 0.85,
        "env1_release": 0.35,
        "lfo2_rate": 5.2,
        "lfo2_mode": "Free",
        "fx_delay_on": true,
        "fx_delay_feedback": 0.35,
        "fx_delay_tone": 5000,
        "fx_delay_mix": 0.2,
        "fx_delay_sync": "1/8.",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.2,
        "fx_reverb_size": 0.5,
        "fx_reverb_decay": 2.6,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "LFO 2", "destination": "Osc1 Fine", "depth": 0.03},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.7},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.4},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5}
    ]
}
