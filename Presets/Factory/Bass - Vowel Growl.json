{
    "name": "Vowel Growl",
    "category": "Bass",
    "description": "A formant filter sweeping through vowels over a saw gives a talking, growling bass.",
    "tags": ["bass", "growl", "formant", "vocal"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": 4.7,
        "osc1_on": true,
        "osc1_frame": 0.5,
        "osc1_level": 0.8,
        "osc1_unison": 2,
        "osc1_detune": 12,
        "osc1_spread": 0.5,
        "filt1_type": "Formant",
        "filt1_cutoff": 700,
        "filt1_res": 0.55,
        "filt1_drive": 0.3,
        "env1_attack": 0.003,
        "env1_decay": 0.3,
        "env1_sustain": 0.85,
        "env1_release": 0.12,
        "lfo1_sync": "1/2",
        "lfo1_mode": "Free",
        "fx_dist_on": true,
        "fx_dist_type": "Hard",
        "fx_dist_drive": 0.3,
        "fx_dist_tone": 0.5,
        "fx_dist_mix": 0.5
    },
    "modulation": [
        {"source": "LFO 1", "destination": "Filt1 Cutoff", "depth": 0.25},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.4},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.0}
    ],
    "lfo_shapes": {"lfo1": "triangle"}
}
