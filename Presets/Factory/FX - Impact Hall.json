{
    "name": "Impact Hall",
    "category": "FX",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A single, enormous hit: a burst of noise with a sub boom underneath, slamming into a huge hall reverb. Place it on the downbeat after a riser.",
    "tags": ["fx", "impact", "hit", "boom", "reverb"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": -1.1,
        "noise_level": 0.8,
        "noise_type": "White",
        "osc1_on": true,
        "osc1_table": "Bass Weight",
        "osc1_frame": 0.2,
        "osc1_level": 0.8,
        "sub_level": 0.6,
        "sub_wave": "Sine",
        "sub_oct": "-2 Oct",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 9000,
        "filt1_res": 0.2,
        "env1_attack": 0.001,
        "env1_decay": 2.4,
        "env1_sustain": 0.0,
        "env1_release": 1.6,
        "env1_dcurve": 0.3,
        "env2_attack": 0.001,
        "env2_decay": 1.6,
        "env2_sustain": 0.0,
        "env2_release": 1.0,
        "env2_dcurve": 0.3,
        "fx_dist_on": true,
        "fx_dist_type": "Soft",
        "fx_dist_drive": 0.3,
        "fx_dist_tone": 0.45,
        "fx_dist_mix": 0.4,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.5,
        "fx_reverb_size": 0.9,
        "fx_reverb_decay": 8.0,
        "fx_reverb_damp": 0.35
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Filt1 Cutoff", "depth": -0.475},
        {"source": "ENV 2", "destination": "Osc1 Fine", "depth": -0.8, "bipolar": false},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.0},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Aftertouch", "destination": "Reverb Mix", "depth": 0.2},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.1}
    ]
}
