{
    "name": "Glass Orchard",
    "category": "Pluck",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "Bright, bell-like FM pluck whose modulation index decays with each note, over a shimmer of sparse glass harmonics an octave up. Icy and expensive-sounding in a dotted echo.",
    "tags": ["pluck", "fm", "glass", "bright", "melodic house"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": 2.4,
        "osc1_on": true,
        "osc1_table": "FM 1:3",
        "osc1_frame": 0.2,
        "osc1_level": 0.85,
        "osc1_unison": 2,
        "osc1_detune": 7,
        "osc1_spread": 0.6,
        "osc1_pan": -0.12,
        "osc2_on": true,
        "osc2_table": "Glass Harmonics",
        "osc2_frame": 0.5,
        "osc2_level": 0.28,
        "osc2_semi": 12,
        "osc2_pan": 0.18,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 6500,
        "filt1_res": 0.1,
        "env1_attack": 0.001,
        "env1_decay": 0.6,
        "env1_sustain": 0.0,
        "env1_release": 0.35,
        "env1_dcurve": 0.5,
        "env2_attack": 0.001,
        "env2_decay": 0.3,
        "env2_sustain": 0.0,
        "env2_release": 0.2,
        "env2_dcurve": 0.6,
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.2,
        "fx_chorus_rate": 0.5,
        "fx_chorus_depth": 0.4,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.42,
        "fx_delay_tone": 5500,
        "fx_delay_mix": 0.28,
        "fx_delay_sync": "1/8.",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.26,
        "fx_reverb_size": 0.6,
        "fx_reverb_decay": 3.2,
        "fx_reverb_damp": 0.3
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Osc1 Frame", "depth": 0.32, "bipolar": false},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.2},
        {"source": "Mod Wheel", "destination": "Osc1 Frame", "depth": 0.3},
        {"source": "Aftertouch", "destination": "Osc2 Level", "depth": 0.2}
    ]
}
