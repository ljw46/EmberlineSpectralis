{
    "name": "Phase Pluck",
    "category": "Pluck",
    "description": "Phase-distortion pluck: the waveform bends from thin to full as the note decays. Digital-FM-like.",
    "tags": ["pluck", "phase", "digital", "fm-like"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": -4.3,
        "osc1_on": true,
        "osc1_frame": 0.0,
        "osc1_level": 0.8,
        "osc1_warp_mode": "Phase Dist",
        "osc1_warp_amt": 0.2,
        "osc2_on": true,
        "osc2_frame": 0.0,
        "osc2_level": 0.3,
        "osc2_semi": 12,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 5000,
        "filt1_res": 0.1,
        "env1_attack": 0.001,
        "env1_decay": 0.6,
        "env1_sustain": 0.0,
        "env1_release": 0.4,
        "env2_attack": 0.001,
        "env2_decay": 0.4,
        "env2_sustain": 0.0,
        "env2_release": 0.2,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.2,
        "fx_reverb_size": 0.5,
        "fx_reverb_decay": 2.5,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Osc1 Warp", "depth": 0.6},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.4},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5}
    ]
}
