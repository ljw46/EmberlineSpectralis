{
    "name": "Formant Lead",
    "category": "Lead",
    "description": "A formant-warped lead with a vowel-like bite that opens as you play harder into the sweep.",
    "tags": ["lead", "formant", "warp", "bite"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": 2.0,
        "osc1_on": true,
        "osc1_frame": 0.4,
        "osc1_level": 0.8,
        "osc1_unison": 3,
        "osc1_detune": 10,
        "osc1_spread": 0.5,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 5000,
        "filt1_res": 0.2,
        "env1_attack": 0.01,
        "env1_decay": 0.3,
        "env1_sustain": 0.8,
        "env1_release": 0.3,
        "lfo1_rate": 0.35,
        "lfo1_mode": "Free",
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.2,
        "fx_chorus_rate": 0.4,
        "fx_chorus_depth": 0.4,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.3,
        "fx_delay_tone": 5000,
        "fx_delay_mix": 0.2,
        "fx_delay_sync": "1/8.",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.2,
        "fx_reverb_size": 0.55,
        "fx_reverb_decay": 2.6,
        "fx_reverb_damp": 0.4,
        "osc1_table": "Vowel Sweep"
    },
    "modulation": [
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.3},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.3}
    ]
}
