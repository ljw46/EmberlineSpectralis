{
    "name": "Velvet Pick",
    "category": "Pluck",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A mellow, rounded guitar pluck with a gentle tube glow: the lowpass sits low so the pick attack stays soft. Intimate and easy on the ears.",
    "tags": ["pluck", "guitar", "mellow", "soft", "deep house"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": 1.0,
        "osc1_on": true,
        "osc1_table": "Acoustic Guitar",
        "osc1_frame": 0.2,
        "osc1_level": 0.9,
        "osc1_pan": -0.06,
        "osc2_on": true,
        "osc2_table": "Bass Weight",
        "osc2_frame": 0.25,
        "osc2_level": 0.3,
        "osc2_semi": -12,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 2000,
        "filt1_res": 0.15,
        "env1_attack": 0.002,
        "env1_decay": 0.6,
        "env1_sustain": 0.0,
        "env1_release": 0.3,
        "env1_dcurve": 0.45,
        "env2_attack": 0.001,
        "env2_decay": 0.3,
        "env2_sustain": 0.0,
        "env2_release": 0.2,
        "fx_dist_on": true,
        "fx_dist_type": "Tube",
        "fx_dist_drive": 0.18,
        "fx_dist_tone": 0.4,
        "fx_dist_mix": 0.3,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.2,
        "fx_reverb_size": 0.5,
        "fx_reverb_decay": 2.4,
        "fx_reverb_damp": 0.55,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.3,
        "fx_delay_tone": 3000,
        "fx_delay_mix": 0.15,
        "fx_delay_sync": "1/8"
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Filt1 Cutoff", "depth": 0.138},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.25},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Aftertouch", "destination": "Osc1 Frame", "depth": 0.2}
    ]
}
