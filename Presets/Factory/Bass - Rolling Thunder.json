{
    "name": "Rolling Thunder",
    "category": "Bass",
    "description": "A bass that carries its own filter: the table opens along with the envelope, so every note has a built-in growl with no filter needed. Warm and punchy.",
    "tags": ["bass", "saw", "sweep", "punchy"],
    "macro_names": ["Brightness", "Morph", "Grit", "Sub"],
    "parameters": {
        "master_volume": -3.1,
        "osc1_on": true,
        "osc1_table": "Saw Sweep",
        "osc1_frame": 0.1,
        "osc1_level": 0.85,
        "osc2_on": true,
        "osc2_table": "Blended Waves",
        "osc2_frame": 0.3,
        "osc2_level": 0.4,
        "osc2_semi": -12,
        "osc2_pan": 0.1,
        "sub_level": 0.3,
        "sub_wave": "Sine",
        "sub_oct": "-1 Oct",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 9000,
        "filt1_res": 0.1,
        "env1_attack": 0.002,
        "env1_decay": 0.32,
        "env1_sustain": 0.75,
        "env1_release": 0.12,
        "env2_attack": 0.001,
        "env2_decay": 0.28,
        "env2_sustain": 0.1,
        "env2_release": 0.2,
        "env2_dcurve": 0.5,
        "fx_dist_on": true,
        "fx_dist_type": "Soft",
        "fx_dist_drive": 0.25,
        "fx_dist_tone": 0.55,
        "fx_dist_mix": 0.4
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Osc1 Frame", "depth": 0.6},
        {"source": "Velocity", "destination": "Osc1 Frame", "depth": 0.25},
        {"source": "Mod Wheel", "destination": "Osc1 Frame", "depth": 0.3},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Macro 3", "destination": "Dist Drive", "depth": 0.5},
        {"source": "Macro 4", "destination": "Sub Level", "depth": 0.5},
        {"source": "Aftertouch", "destination": "Dist Mix", "depth": 0.15}
    ]
}
