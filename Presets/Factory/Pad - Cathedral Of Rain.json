{
    "name": "Cathedral Of Rain",
    "category": "Pad",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A tonewheel-organ chord swell under a haze of fine rain crackle, bathed in a very long reverb. Sacred, grey and quietly beautiful.",
    "tags": ["pad", "organ", "rain", "reverb", "ambient"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": 1.4,
        "osc1_on": true,
        "osc1_table": "Tonewheel Organ",
        "osc1_frame": 0.4,
        "osc1_level": 0.65,
        "osc1_unison": 3,
        "osc1_detune": 8,
        "osc1_spread": 0.7,
        "osc1_pan": -0.15,
        "osc2_on": true,
        "osc2_table": "Organ Drawbars",
        "osc2_frame": 0.6,
        "osc2_level": 0.35,
        "osc2_unison": 2,
        "osc2_detune": 6,
        "osc2_spread": 0.5,
        "osc2_semi": 12,
        "osc2_pan": 0.18,
        "osc3_on": true,
        "osc3_table": "Glass Harmonics",
        "osc3_frame": 0.3,
        "osc3_level": 0.15,
        "osc3_semi": 19,
        "noise_level": 0.09,
        "noise_type": "Crackle",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 3200,
        "filt1_res": 0.15,
        "env1_attack": 1.4,
        "env1_decay": 1.0,
        "env1_sustain": 0.85,
        "env1_release": 3.0,
        "lfo1_rate": 0.05,
        "lfo1_mode": "Free",
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.28,
        "fx_chorus_rate": 0.3,
        "fx_chorus_depth": 0.5,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.5,
        "fx_reverb_size": 0.9,
        "fx_reverb_decay": 9.0,
        "fx_reverb_damp": 0.35,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.45,
        "fx_delay_tone": 3000,
        "fx_delay_mix": 0.15,
        "fx_delay_sync": "1/2"
    },
    "modulation": [
        {"source": "LFO 1", "destination": "Filt1 Cutoff", "depth": 0.1},
        {"source": "Perlin", "destination": "Osc2 Frame", "depth": 0.3},
        {"source": "Chaos Z", "destination": "Osc3 Level", "depth": 0.1},
        {"source": "Perlin", "destination": "Noise Level", "depth": 0.04},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc2 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.1},
        {"source": "Mod Wheel", "destination": "Reverb Mix", "depth": 0.3},
        {"source": "Aftertouch", "destination": "Osc2 Frame", "depth": 0.2}
    ]
}
