{
    "name": "Square Bass",
    "category": "Bass",
    "description": "Hollow, woody square bass. Mid-focused so it cuts through on small speakers.",
    "tags": ["bass", "square", "hollow"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": -0.6,
        "osc1_on": true,
        "osc1_frame": 0.04,
        "osc1_level": 0.8,
        "sub_level": 0.3,
        "sub_wave": "Sine",
        "sub_oct": "-1 Oct",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 800,
        "filt1_res": 0.3,
        "env1_attack": 0.002,
        "env1_decay": 0.3,
        "env1_sustain": 0.6,
        "env1_release": 0.12,
        "env2_attack": 0.001,
        "env2_decay": 0.25,
        "env2_sustain": 0.0,
        "env2_release": 0.2,
        "osc1_table": "Pulse Width"
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Filt1 Cutoff", "depth": 0.155},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.4},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5}
    ]
}
