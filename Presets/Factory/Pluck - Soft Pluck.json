{
    "name": "Soft Pluck",
    "category": "Pluck",
    "description": "Gentle triangle pluck. Rounded, no harsh edges - lovely for intimate melodies.",
    "tags": ["pluck", "soft", "gentle"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": 1.3,
        "osc1_on": true,
        "osc1_frame": 0.27,
        "osc1_level": 0.8,
        "osc1_unison": 2,
        "osc1_detune": 7,
        "osc1_spread": 0.5,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 1400,
        "filt1_res": 0.1,
        "env1_attack": 0.003,
        "env1_decay": 0.55,
        "env1_sustain": 0.0,
        "env1_release": 0.3,
        "env2_attack": 0.001,
        "env2_decay": 0.4,
        "env2_sustain": 0.0,
        "env2_release": 0.2,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.22,
        "fx_reverb_size": 0.6,
        "fx_reverb_decay": 2.8,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Filt1 Cutoff", "depth": 0.175},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.3},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.4}
    ]
}
