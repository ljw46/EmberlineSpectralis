{
    "name": "Breathy Lead",
    "category": "Lead",
    "description": "Airy lead with audible breath noise riding on top. Intimate and human.",
    "tags": ["lead", "breathy", "airy", "noise"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": -3.5,
        "osc1_on": true,
        "osc1_frame": 0.35,
        "osc1_level": 0.8,
        "osc1_unison": 2,
        "osc1_detune": 6,
        "osc1_spread": 0.5,
        "noise_level": 0.07,
        "noise_type": "Pink",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 4200,
        "filt1_res": 0.15,
        "env1_attack": 0.04,
        "env1_decay": 0.3,
        "env1_sustain": 0.8,
        "env1_release": 0.35,
        "lfo2_rate": 4.8,
        "lfo2_mode": "Free",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.28,
        "fx_reverb_size": 0.6,
        "fx_reverb_decay": 3.0,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "LFO 2", "destination": "Osc1 Fine", "depth": 0.03},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.2},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.3}
    ]
