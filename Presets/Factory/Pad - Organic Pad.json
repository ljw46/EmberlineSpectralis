{
    "name": "Organic Pad",
    "category": "Pad",
    "description": "Warm pad with a trace of pink noise, slow filter drift and chaotic pan wander. Feels hand-played.",
    "tags": ["pad", "organic", "warm", "natural"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": -0.8,
        "osc1_on": true,
        "osc1_frame": 0.35,
        "osc1_level": 0.65,
        "osc1_unison": 4,
        "osc1_detune": 15,
        "osc1_spread": 0.85,
        "osc2_on": true,
        "osc2_frame": 0.6,
        "osc2_level": 0.4,
        "osc2_unison": 3,
        "osc2_detune": 11,
        "osc2_spread": 0.75,
        "osc2_semi": 7,
        "noise_level": 0.05,
        "noise_type": "Pink",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 2200,
        "filt1_res": 0.2,
        "env1_attack": 1.2,
        "env1_decay": 1.0,
        "env1_sustain": 0.8,
        "env1_release": 2.2,
        "lfo1_rate": 0.15,
        "lfo1_mode": "Free",
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.3,
        "fx_chorus_rate": 0.3,
        "fx_chorus_depth": 0.5,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.4,
        "fx_reverb_size": 0.8,
        "fx_reverb_decay": 6.0,
        "fx_reverb_damp": 0.4,
        "osc1_table": "Organ Drawbars"
