        "osc1_detune": 14,
        "osc1_spread": 0.9,
        "osc2_on": true,
        "osc2_frame": 0.2,
        "osc2_level": 0.4,
        "osc2_unison": 2,
        "osc2_detune": 8,
        "osc2_spread": 0.5,
        "osc2_semi": 12,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 7000,
        "filt1_res": 0.15,
        "env1_attack": 1.0,
        "env1_decay": 1.0,
        "env1_sustain": 0.85,
