{
    "name": "Deep Sub",
    "category": "Bass",
    "description": "Pure, round sub for deep house. Sine body with a sub layer and a hint of saturation. Mono-friendly, stays under 150 Hz.",
    "tags": ["bass", "sub", "deep house"],
    "macro_names": ["Brightness", "Body", "Resonance", "-"],
    "parameters": {
        "master_volume": -3.8,
        "osc1_on": true,
        "osc1_frame": 0.02,
        "osc1_level": 0.7,
        "sub_level": 0.7,
        "sub_wave": "Sine",
        "sub_oct": "-1 Oct",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 500,
        "filt1_res": 0.1,
        "env1_attack": 0.003,
        "env1_decay": 0.4,
        "env1_sustain": 0.9,
        "env1_release": 0.15,
        "fx_dist_on": true,
        "fx_dist_type": "Soft",
        "fx_dist_drive": 0.15,
        "fx_dist_tone": 0.4,
        "fx_dist_mix": 0.3
    },
    "modulation": [
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.3},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.2},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.0}
    ]
}
