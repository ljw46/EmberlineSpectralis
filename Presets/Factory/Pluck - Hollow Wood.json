{
    "name": "Hollow Wood",
    "category": "Pluck",
    "description": "A dry, hollow wooden pluck: a clarinet-table tone with a pulse wave underneath. Fast, rhythmic and sits well beside a shaker.",
    "tags": ["pluck", "wood", "hollow", "dry", "organic house"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": 4.3,
        "osc1_on": true,
        "osc1_table": "Clarinet",
        "osc1_frame": 0.3,
        "osc1_level": 0.85,
        "osc1_pan": -0.08,
        "osc2_on": true,
        "osc2_table": "Pulse Width",
        "osc2_frame": 0.1,
        "osc2_level": 0.35,
        "osc2_semi": 12,
        "osc2_pan": 0.1,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 2200,
        "filt1_res": 0.2,
        "env1_attack": 0.001,
        "env1_decay": 0.2,
        "env1_sustain": 0.0,
        "env1_release": 0.1,
        "env1_dcurve": 0.6,
        "env2_attack": 0.001,
        "env2_decay": 0.14,
        "env2_sustain": 0.0,
        "env2_release": 0.08,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.14,
        "fx_reverb_size": 0.35,
        "fx_reverb_decay": 1.4,
        "fx_reverb_damp": 0.55,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.25,
        "fx_delay_tone": 4000,
        "fx_delay_mix": 0.1,
        "fx_delay_sync": "1/8"
