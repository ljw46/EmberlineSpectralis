{
    "name": "Soft Arp",
    "category": "Arp",
    "description": "Gentle, rounded arp that sits back in the mix. Triangle-based with a smooth tail.",
    "tags": ["arp", "soft", "gentle", "round"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": 2.7,
        "osc1_on": true,
        "osc1_frame": 0.25,
        "osc1_level": 0.8,
        "osc1_unison": 2,
        "osc1_detune": 5,
        "osc1_spread": 0.5,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 2200,
        "filt1_res": 0.1,
        "env1_attack": 0.003,
        "env1_decay": 0.28,
        "env1_sustain": 0.0,
        "env1_release": 0.2,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.4,
        "fx_delay_tone": 4000,
        "fx_delay_mix": 0.25,
        "fx_delay_sync": "1/8.",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.25,
        "fx_reverb_size": 0.6,
        "fx_reverb_decay": 3.0,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.2},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.3}
    ]
}
