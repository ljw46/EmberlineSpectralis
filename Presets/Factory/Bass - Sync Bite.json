{
    "name": "Sync Bite",
    "category": "Bass",
    "description": "Hard-sync style bass: the sync amount snaps down with the envelope for a biting attack that settles warm.",
    "tags": ["bass", "sync", "bite", "bright"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": 2.4,
        "osc1_on": true,
        "osc1_frame": 0.12,
        "osc1_level": 0.8,
        "sub_level": 0.3,
        "sub_wave": "Sine",
        "sub_oct": "-1 Oct",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 1500,
        "filt1_res": 0.2,
        "env1_attack": 0.002,
        "env1_decay": 0.3,
        "env1_sustain": 0.7,
        "env1_release": 0.12,
        "env2_attack": 0.001,
        "env2_decay": 0.3,
        "env2_sustain": 0.0,
        "env2_release": 0.2,
        "env2_dcurve": 0.5,
        "osc1_table": "Saw Sync"
    },
    "modulation": [
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.4},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "ENV 2", "destination": "Osc1 Frame", "depth": 0.45}
    ]
