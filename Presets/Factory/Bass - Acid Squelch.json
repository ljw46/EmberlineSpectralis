{
    "name": "Acid Squelch",
    "category": "Bass",
    "description": "Resonant, squelchy 303-flavoured bass. High resonance with a fast filter envelope and a touch of drive.",
    "tags": ["bass", "acid", "resonant", "squelch"],
    "macro_names": ["Cutoff", "Wave", "Squelch", "-"],
    "parameters": {
        "master_volume": -1.0,
        "osc1_on": true,
        "osc1_frame": 0.5,
        "osc1_level": 0.8,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 500,
        "filt1_res": 0.72,
        "filt1_drive": 0.3,
        "env1_attack": 0.001,
        "env1_decay": 0.2,
        "env1_sustain": 0.6,
        "env1_release": 0.08,
        "env2_attack": 0.001,
        "env2_decay": 0.18,
        "env2_sustain": 0.0,
        "env2_release": 0.15,
        "env2_dcurve": 0.6,
        "fx_dist_on": true,
        "fx_dist_type": "Hard",
        "fx_dist_drive": 0.2,
        "fx_dist_tone": 0.55,
        "fx_dist_mix": 0.5
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Filt1 Cutoff", "depth": 0.266},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.2},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.2},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.0}
    ]
}
