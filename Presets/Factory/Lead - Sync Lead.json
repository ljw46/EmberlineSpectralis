{
    "name": "Sync Lead",
    "category": "Lead",
    "description": "Hard-sync lead whose sweep is steered by a slow LFO. Cutting, vintage, and animated.",
    "tags": ["lead", "sync", "retro", "cutting"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": -1.6,
        "osc1_on": true,
        "osc1_frame": 0.4,
        "osc1_level": 0.8,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 5000,
        "filt1_res": 0.2,
        "env1_attack": 0.005,
        "env1_decay": 0.3,
        "env1_sustain": 0.8,
        "env1_release": 0.25,
        "lfo1_rate": 0.4,
        "lfo1_mode": "Free",
        "fx_delay_on": true,
        "fx_delay_feedback": 0.3,
        "fx_delay_tone": 5000,
        "fx_delay_mix": 0.2,
        "fx_delay_sync": "1/8.",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.15,
        "fx_reverb_size": 0.5,
        "fx_reverb_decay": 2.0,
        "fx_reverb_damp": 0.4,
        "osc1_table": "Saw Sync"
    },
    "modulation": [
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.3},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.3},
        {"source": "LFO 1", "destination": "Osc1 Frame", "depth": 0.22}
    ]
}
