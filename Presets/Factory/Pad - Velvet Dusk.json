{
    "name": "Velvet Dusk",
    "category": "Pad",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "Warm string-section pad: recorded cello and violin cycles blended and widened, with a slow bow-like swell and a shimmer of vibrato. Plush, dark and romantic.",
    "tags": ["pad", "strings", "cello", "violin", "warm", "slow"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": 1.1,
        "osc1_on": true,
        "osc1_table": "Cello",
        "osc1_frame": 0.25,
        "osc1_level": 0.7,
        "osc1_unison": 3,
        "osc1_detune": 10,
        "osc1_spread": 0.8,
        "osc1_pan": -0.2,
        "osc2_on": true,
        "osc2_table": "Violin",
        "osc2_frame": 0.4,
        "osc2_level": 0.5,
        "osc2_unison": 3,
        "osc2_detune": 11,
        "osc2_spread": 0.8,
        "osc2_semi": 12,
        "osc2_pan": 0.2,
        "osc3_on": true,
        "osc3_table": "Brass Swell",
        "osc3_frame": 0.15,
        "osc3_level": 0.25,
        "osc3_semi": -12,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 2400,
        "filt1_res": 0.15,
        "env1_attack": 0.9,
        "env1_decay": 1.0,
        "env1_sustain": 0.85,
        "env1_release": 2.2,
        "env1_acurve": -0.2,
        "lfo1_rate": 0.09,
        "lfo1_mode": "Free",
        "lfo2_rate": 4.9,
        "lfo2_mode": "Free",
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.3,
        "fx_chorus_rate": 0.32,
        "fx_chorus_depth": 0.5,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.34,
        "fx_reverb_size": 0.75,
        "fx_reverb_decay": 5.0,
        "fx_reverb_damp": 0.5
    },
    "modulation": [
        {"source": "LFO 1", "destination": "Filt1 Cutoff", "depth": 0.1},
        {"source": "LFO 2", "destination": "Osc1 Fine", "depth": 0.012},
        {"source": "LFO 2", "destination": "Osc2 Fine", "depth": 0.015},
        {"source": "Perlin", "destination": "Osc1 Frame", "depth": 0.2},
        {"source": "Perlin", "destination": "Osc2 Frame", "depth": 0.25},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc2 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.1},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Aftertouch", "destination": "Osc2 Frame", "depth": 0.2}
    ]
