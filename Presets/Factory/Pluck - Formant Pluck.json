{
    "name": "Formant Pluck",
    "category": "Pluck",
    "description": "A formant-warped pluck that 'speaks' on each note and relaxes as it decays.",
    "tags": ["pluck", "formant", "vocal", "warp"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": 4.8,
        "osc1_on": true,
        "osc1_frame": 0.5,
        "osc1_level": 1.0,
        "osc1_unison": 2,
        "osc1_detune": 8,
        "osc1_spread": 0.5,
        "osc1_warp_mode": "Formant",
        "osc1_warp_amt": 0.55,
        "osc2_on": true,
        "osc2_frame": 0.5,
        "osc2_level": 0.6,
        "osc2_unison": 2,
        "osc2_detune": 11,
        "osc2_spread": 0.5,
        "osc2_semi": 12,
        "osc2_warp_mode": "Formant",
        "osc2_warp_amt": 0.55,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 2800,
        "filt1_res": 0.15,
        "env1_attack": 0.002,
        "env1_decay": 0.5,
        "env1_sustain": 0.0,
        "env1_release": 0.3,
        "env2_attack": 0.001,
        "env2_decay": 0.4,
        "env2_sustain": 0.0,
        "env2_release": 0.2,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.2,
        "fx_reverb_size": 0.55,
        "fx_reverb_decay": 2.4,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Osc1 Warp", "depth": -0.4, "bipolar": false},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.4},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5}
    ]
}
