{
    "name": "Sparkler",
    "category": "Pluck",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A high, fizzing bell pluck: FM and Fibonacci partials stacked for a glittering burst that dies fast. A lovely topline over deep, dark chords.",
    "tags": ["pluck", "bell", "glitter", "high", "melodic house"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": 2.8,
        "osc1_on": true,
        "osc1_table": "FM 1:5 Bell",
        "osc1_frame": 0.3,
        "osc1_level": 0.75,
        "osc1_semi": 12,
        "osc1_pan": -0.15,
        "osc2_on": true,
        "osc2_table": "Fibonacci Bell",
        "osc2_frame": 0.35,
        "osc2_level": 0.45,
        "osc2_semi": 12,
        "osc2_pan": 0.2,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 9500,
        "filt1_res": 0.1,
        "env1_attack": 0.001,
        "env1_decay": 0.5,
        "env1_sustain": 0.0,
        "env1_release": 0.35,
        "env1_dcurve": 0.5,
        "env2_attack": 0.001,
        "env2_decay": 0.18,
        "env2_sustain": 0.0,
        "env2_release": 0.1,
        "env2_dcurve": 0.6,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.4,
        "fx_delay_tone": 6500,
        "fx_delay_mix": 0.28,
        "fx_delay_sync": "1/8",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.3,
        "fx_reverb_size": 0.7,
        "fx_reverb_decay": 3.6,
        "fx_reverb_damp": 0.25
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Osc1 Frame", "depth": 0.3},
        {"source": "ENV 2", "destination": "Osc2 Frame", "depth": 0.3},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.35},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.15},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.25},
        {"source": "Aftertouch", "destination": "Osc2 Level", "depth": 0.2}
    ]
}
