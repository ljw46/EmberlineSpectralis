{
    "name": "Marimba",
    "category": "Organic",
    "description": "Wooden mallet tone with a quick decay and a hollow resonance.",
    "tags": ["organic", "marimba", "mallet", "wooden"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": -1.0,
        "osc1_on": true,
        "osc1_frame": 0.7,
        "osc1_level": 0.8,
        "osc2_on": true,
        "osc2_frame": 0.0,
        "osc2_level": 0.3,
        "osc2_semi": 24,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 3500,
        "filt1_res": 0.15,
        "env1_attack": 0.001,
        "env1_decay": 0.45,
        "env1_sustain": 0.0,
        "env1_release": 0.25,
        "env1_dcurve": 0.5,
        "env2_attack": 0.001,
        "env2_decay": 0.2,
        "env2_sustain": 0.0,
        "env2_release": 0.1,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.2,
        "fx_reverb_size": 0.5,
        "fx_reverb_decay": 2.2,
        "fx_reverb_damp": 0.5,
        "osc1_table": "Mallet"
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Filt1 Cutoff", "depth": 0.149},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.2},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.1},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.2}
    ]
