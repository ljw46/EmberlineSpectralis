{
    "name": "Coal Fire",
    "category": "Bass",
    "description": "A snarling, harmonically dense bass built from a distorted-waveform table and a wavefolder. Gritty but controlled - the Grit macro takes it from smoulder to roar.",
    "tags": ["bass", "distorted", "gritty", "aggressive"],
    "macro_names": ["Brightness", "Morph", "Grit", "Sub"],
    "parameters": {
        "master_volume": -1.7,
        "osc1_on": true,
        "osc1_table": "Distorted",
        "osc1_frame": 0.2,
        "osc1_level": 0.75,
        "osc2_on": true,
        "osc2_table": "Sine Fold",
        "osc2_frame": 0.1,
        "osc2_level": 0.4,
        "osc2_semi": -12,
        "sub_level": 0.35,
        "sub_wave": "Sine",
        "sub_oct": "-1 Oct",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 900,
        "filt1_res": 0.3,
        "filt1_drive": 0.3,
        "env1_attack": 0.002,
        "env1_decay": 0.3,
        "env1_sustain": 0.8,
        "env1_release": 0.12,
        "env2_attack": 0.001,
        "env2_decay": 0.2,
        "env2_sustain": 0.2,
        "env2_release": 0.15,
        "fx_dist_on": true,
        "fx_dist_type": "Fold",
        "fx_dist_drive": 0.35,
        "fx_dist_tone": 0.5,
        "fx_dist_mix": 0.5
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Osc2 Frame", "depth": 0.5},
        {"source": "ENV 2", "destination": "Filt1 Cutoff", "depth": 0.141},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Dist Drive", "depth": 0.6},
        {"source": "Macro 4", "destination": "Sub Level", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.18},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.28},
        {"source": "Aftertouch", "destination": "Dist Mix", "depth": 0.12}
    ]
}
