{
    "name": "Formant Choir Morph",
    "category": "Pad",
    "description": "A choir pad that slowly breathes through the vowels by itself. Wide, airy and vocal.",
    "tags": ["pad", "choir", "vowel", "wavetable", "evolving"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": 1.3,
        "osc1_table": "Vowel Sweep",
        "osc2_table": "Vowel Sweep",
        "osc2_on": true,
        "osc2_frame": 0.7,
        "osc1_on": true,
        "osc1_frame": 0.2,
        "osc1_level": 0.7,
        "osc1_unison": 5,
        "osc1_detune": 14,
        "osc1_spread": 0.9,
        "osc2_level": 0.5,
        "osc2_unison": 4,
        "osc2_detune": 11,
        "osc2_spread": 0.8,
        "osc2_semi": 12,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 5000,
        "filt1_res": 0.15,
        "env1_attack": 1.0,
        "env1_decay": 1.0,
        "env1_sustain": 0.85,
        "env1_release": 2.2,
        "lfo1_rate": 0.07,
        "lfo1_mode": "Free",
        "lfo2_rate": 0.11,
        "lfo2_mode": "Free",
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.35,
        "fx_chorus_rate": 0.3,
        "fx_chorus_depth": 0.5,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.4,
        "fx_reverb_size": 0.8,
        "fx_reverb_decay": 6.0,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "LFO 1", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "LFO 2", "destination": "Osc2 Frame", "depth": 0.5},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.2},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5}
    ]
}
