{
    "name": "Steps Lead",
    "category": "Lead",
    "description": "A gritty bit-crushed lead: Macro 2 reduces the stair-step resolution from smooth to chunky.",
    "tags": ["lead", "bitcrush", "steps", "lo-fi", "wavetable"],
    "macro_names": ["Brightness", "Crush", "Resonance", "Width"],
    "parameters": {
        "master_volume": -4.6,
        "osc1_table": "Steps",
        "osc1_on": true,
        "osc1_frame": 0.2,
        "osc1_level": 0.8,
        "osc1_unison": 2,
        "osc1_detune": 6,
        "osc1_spread": 0.5,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 6500,
        "filt1_res": 0.15,
        "env1_attack": 0.01,
        "env1_decay": 0.3,
        "env1_sustain": 0.85,
        "env1_release": 0.3,
        "lfo2_rate": 5.0,
        "lfo2_mode": "Free",
        "fx_delay_on": true,
        "fx_delay_feedback": 0.3,
        "fx_delay_tone": 4500,
        "fx_delay_mix": 0.2,
        "fx_delay_sync": "1/8",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.2,
        "fx_reverb_size": 0.5,
        "fx_reverb_decay": 2.4,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "LFO 2", "destination": "Osc1 Fine", "depth": 0.03},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": -0.6},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.4},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5}
    ]
}
