{
    "name": "Glass Pluck",
    "category": "Pluck",
    "description": "Bright, brittle formant-flavoured pluck with a long airy reverb. Icy and shimmering.",
    "tags": ["pluck", "glass", "bright", "icy"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": 2.5,
        "osc1_on": true,
        "osc1_frame": 0.9,
        "osc1_level": 0.7,
        "osc1_unison": 2,
        "osc1_detune": 8,
        "osc1_spread": 0.5,
        "osc2_on": true,
        "osc2_frame": 0.0,
        "osc2_level": 0.3,
        "osc2_semi": 12,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 2400,
        "filt1_res": 0.2,
        "env1_attack": 0.001,
        "env1_decay": 0.5,
        "env1_sustain": 0.0,
        "env1_release": 0.4,
        "env2_attack": 0.001,
        "env2_decay": 0.3,
        "env2_sustain": 0.0,
        "env2_release": 0.2,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.3,
        "fx_reverb_size": 0.7,
        "fx_reverb_decay": 4.0,
        "fx_reverb_damp": 0.3,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.35,
        "fx_delay_tone": 6000,
        "fx_delay_mix": 0.2,
        "fx_delay_sync": "1/8."
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Filt1 Cutoff", "depth": 0.274},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.2},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.4}
    ]
}
