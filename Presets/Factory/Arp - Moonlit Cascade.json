{
    "name": "Moonlit Cascade",
    "category": "Arp",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A latched, drifting cascade: three octaves of triplet sixteenths converging towards the middle, long gates and a wide echo. Press a chord once and walk away - it keeps playing.",
    "tags": ["arp", "built-in arp", "latch", "ambient", "cascade", "converge"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": 4.2,
        "osc1_on": true,
        "osc1_table": "Fibonacci Bell",
        "osc1_frame": 0.3,
        "osc1_level": 0.6,
        "osc1_unison": 2,
        "osc1_detune": 8,
        "osc1_spread": 0.8,
        "osc1_pan": -0.14,
        "osc2_on": true,
        "osc2_table": "Grand Piano",
        "osc2_frame": 0.3,
        "osc2_level": 0.45,
        "osc2_semi": 12,
        "osc2_pan": 0.18,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 5200,
        "filt1_res": 0.15,
        "env1_attack": 0.002,
        "env1_decay": 0.6,
        "env1_sustain": 0.0,
        "env1_release": 0.5,
        "env1_dcurve": 0.45,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.45,
        "fx_delay_tone": 4500,
        "fx_delay_mix": 0.3,
        "fx_delay_sync": "1/4.",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.34,
        "fx_reverb_size": 0.75,
        "fx_reverb_decay": 4.5,
        "fx_reverb_damp": 0.4,
        "arp_on": true,
        "arp_mode": "Converge",
        "arp_rate": "1/16T",
        "arp_octaves": 3,
        "arp_gate": 0.85,
        "arp_latch": true,
        "arp_humanize": 0.2
    },
    "modulation": [
        {"source": "Perlin", "destination": "Osc2 Level", "depth": 0.15},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.45},
        {"source": "Macro 2", "destination": "Osc2 Frame", "depth": 0.45},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.22},
        {"source": "Velocity", "destination": "Osc1 Frame", "depth": 0.2},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Aftertouch", "destination": "Osc2 Level", "depth": 0.2}
    ]
}
