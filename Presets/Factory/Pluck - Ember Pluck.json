{
    "name": "Ember Pluck",
    "category": "Pluck",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A hard-sync sweep on every note: a sine restarts several times per cycle and the ratio collapses as the note decays, giving a vowel-like 'yow'. Retro and punchy.",
    "tags": ["pluck", "sync", "retro", "punchy"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": 0.5,
        "osc1_on": true,
        "osc1_table": "Sync Sweep",
        "osc1_frame": 0.05,
        "osc1_level": 0.85,
        "osc1_unison": 2,
        "osc1_detune": 6,
        "osc1_spread": 0.5,
        "osc1_pan": -0.1,
        "osc2_on": true,
        "osc2_table": "Saw Sync",
        "osc2_frame": 0.05,
        "osc2_level": 0.35,
        "osc2_semi": -12,
        "osc2_pan": 0.1,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 3800,
        "filt1_res": 0.18,
        "env1_attack": 0.001,
        "env1_decay": 0.45,
        "env1_sustain": 0.0,
        "env1_release": 0.25,
        "env1_dcurve": 0.5,
        "env2_attack": 0.001,
        "env2_decay": 0.28,
        "env2_sustain": 0.0,
        "env2_release": 0.2,
        "env2_dcurve": 0.6,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.35,
        "fx_delay_tone": 5000,
        "fx_delay_mix": 0.22,
        "fx_delay_sync": "1/8",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.16,
        "fx_reverb_size": 0.5,
        "fx_reverb_decay": 2.2,
        "fx_reverb_damp": 0.45,
        "fx_dist_on": true,
        "fx_dist_type": "Soft",
        "fx_dist_drive": 0.15,
        "fx_dist_tone": 0.6,
        "fx_dist_mix": 0.3
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Osc1 Frame", "depth": 0.6},
        {"source": "ENV 2", "destination": "Osc2 Frame", "depth": 0.5},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc2 Frame", "depth": 0.4},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.2},
        {"source": "Mod Wheel", "destination": "Osc1 Frame", "depth": 0.25},
        {"source": "Aftertouch", "destination": "Filt1 Cutoff", "depth": 0.2}
    ]
}
