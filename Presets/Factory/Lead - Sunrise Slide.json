{
    "name": "Sunrise Slide",
    "category": "Lead",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A smooth mono lead that slurs from note to note with a gentle glide, like a vocal. Soft saw and a touch of chorus, with a dotted-eighth echo that follows the slides.",
    "tags": ["lead", "glide", "portamento", "mono", "legato", "melodic house"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": 6.0,
        "osc1_on": true,
        "osc1_table": "Saw Sweep",
        "osc1_frame": 0.3,
        "osc1_level": 0.8,
        "osc1_unison": 3,
        "osc1_detune": 10,
        "osc1_spread": 0.5,
        "osc2_on": true,
        "osc2_table": "Blended Waves",
        "osc2_frame": 0.4,
        "osc2_level": 0.3,
        "osc2_semi": 12,
        "osc2_pan": 0.12,
        "filt1_type": "Ladder",
        "filt1_cutoff": 3200,
        "filt1_res": 0.25,
        "filt1_drive": 0.1,
        "env1_attack": 0.01,
        "env1_decay": 0.4,
        "env1_sustain": 0.8,
        "env1_release": 0.35,
        "lfo1_rate": 5.2,
        "lfo1_mode": "Free",
        "voice_mode": "Legato",
        "glide_time": 0.14,
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.25,
        "fx_chorus_rate": 0.45,
        "fx_chorus_depth": 0.4,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.4,
        "fx_delay_tone": 4800,
        "fx_delay_mix": 0.26,
        "fx_delay_sync": "1/8.",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.2,
        "fx_reverb_size": 0.55,
        "fx_reverb_decay": 2.8,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "LFO 1", "destination": "Osc1 Fine", "depth": 0.01},
        {"source": "Mod Wheel", "destination": "Osc1 Fine", "depth": 0.03},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.25},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Aftertouch", "destination": "Osc1 Frame", "depth": 0.15}
    ]
}
