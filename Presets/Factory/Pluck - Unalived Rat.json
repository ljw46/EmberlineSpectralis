{
    "name": "Unalived Rat",
    "category": "Pluck",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A tight, squelchy progressive-house pluck: detuned saws, a resonant 24 dB filter that snaps shut on every note and a hint of glide in mono so quick runs slur. A bit out of genre for deep house, but it cuts through anything.",
    "tags": ["pluck", "progressive", "squelchy", "mono", "resonant", "big room"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": 6.0,
        "osc1_on": true,
        "osc1_table": "Saw Sweep",
        "osc1_frame": 0.5,
        "osc1_level": 0.8,
        "osc1_unison": 3,
        "osc1_detune": 14,
        "osc1_spread": 0.45,
        "osc1_pan": -0.08,
        "osc2_on": true,
        "osc2_table": "Pulse Width",
        "osc2_frame": 0.35,
        "osc2_level": 0.45,
        "osc2_unison": 2,
        "osc2_detune": 9,
        "osc2_spread": 0.5,
        "osc2_semi": -12,
        "osc2_pan": 0.1,
        "sub_level": 0.12,
        "sub_wave": "Sine",
        "sub_oct": "-1 Oct",
        "filt1_type": "Ladder",
        "filt1_cutoff": 480,
        "filt1_res": 0.46,
        "filt1_drive": 0.2,
        "filt1_slope": "24 dB",
        "env1_attack": 0.001,
        "env1_decay": 0.26,
        "env1_sustain": 0.0,
        "env1_release": 0.2,
        "env1_dcurve": 0.5,
        "env2_attack": 0.001,
        "env2_decay": 0.2,
        "env2_sustain": 0.0,
        "env2_release": 0.15,
        "env2_dcurve": 0.55,
        "voice_mode": "Mono",
        "glide_time": 0.04,
        "fx_dist_on": true,
        "fx_dist_type": "Soft",
        "fx_dist_drive": 0.22,
        "fx_dist_tone": 0.6,
        "fx_dist_mix": 0.35,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.38,
        "fx_delay_tone": 5200,
        "fx_delay_mix": 0.26,
        "fx_delay_sync": "1/8.",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.14,
        "fx_reverb_size": 0.5,
        "fx_reverb_decay": 2.0,
        "fx_reverb_damp": 0.45
