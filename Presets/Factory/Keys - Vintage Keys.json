{
    "name": "Vintage Keys",
    "category": "Keys",
    "description": "Old-school keys with tube warmth and chorus - like a well-loved stage piano.",
    "tags": ["keys", "vintage", "tube", "warm"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": -0.7,
        "osc1_on": true,
        "osc1_frame": 0.3,
        "osc1_level": 0.8,
        "osc1_unison": 2,
        "osc1_detune": 8,
        "osc1_spread": 0.5,
        "osc2_on": true,
        "osc2_frame": 0.5,
        "osc2_level": 0.25,
        "osc2_semi": 12,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 3200,
        "filt1_res": 0.15,
        "env1_attack": 0.003,
        "env1_decay": 0.9,
        "env1_sustain": 0.3,
        "env1_release": 0.5,
        "fx_dist_on": true,
        "fx_dist_type": "Tube",
        "fx_dist_drive": 0.3,
        "fx_dist_tone": 0.45,
        "fx_dist_mix": 0.5,
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.4,
        "fx_chorus_rate": 0.5,
        "fx_chorus_depth": 0.45,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.2,
        "fx_reverb_size": 0.5,
        "fx_reverb_decay": 2.5,
        "fx_reverb_damp": 0.5
    },
    "modulation": [
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.2},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.4}
    ]
}
