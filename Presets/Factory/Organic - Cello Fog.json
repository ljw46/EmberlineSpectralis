{
    "name": "Cello Fog",
    "category": "Organic",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A low, bowed-cello drone-pad that rolls in like fog: slow attack, subtle vibrato, a sub-octave of warmth underneath. Sombre, woody and a little haunted.",
    "tags": ["organic", "cello", "bowed", "drone", "sombre"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": -1.0,
        "osc1_on": true,
        "osc1_table": "Cello",
        "osc1_frame": 0.2,
        "osc1_level": 0.8,
        "osc1_unison": 3,
        "osc1_detune": 8,
        "osc1_spread": 0.7,
        "osc1_pan": -0.2,
        "osc2_on": true,
        "osc2_table": "Cello",
        "osc2_frame": 0.4,
        "osc2_level": 0.5,
        "osc2_unison": 2,
        "osc2_detune": 7,
        "osc2_spread": 0.5,
        "osc2_semi": 12,
        "osc2_pan": 0.2,
        "osc3_on": true,
        "osc3_table": "Bass Weight",
        "osc3_frame": 0.2,
        "osc3_level": 0.35,
        "osc3_semi": -12,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 2200,
        "filt1_res": 0.15,
        "env1_attack": 1.0,
        "env1_decay": 1.0,
        "env1_sustain": 0.9,
        "env1_release": 2.6,
        "env1_acurve": -0.2,
        "lfo1_rate": 0.08,
        "lfo1_mode": "Free",
        "lfo2_rate": 4.7,
        "lfo2_mode": "Free",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.4,
        "fx_reverb_size": 0.8,
        "fx_reverb_decay": 5.5,
        "fx_reverb_damp": 0.5,
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.18,
        "fx_chorus_rate": 0.3,
        "fx_chorus_depth": 0.4
    },
    "modulation": [
        {"source": "LFO 1", "destination": "Filt1 Cutoff", "depth": 0.12},
        {"source": "LFO 2", "destination": "Osc1 Fine", "depth": 0.012},
        {"source": "Perlin", "destination": "Osc1 Frame", "depth": 0.3},
        {"source": "Perlin", "destination": "Osc2 Frame", "depth": 0.3},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc2 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.1},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Aftertouch", "destination": "Osc2 Level", "depth": 0.25}
    ]
}
