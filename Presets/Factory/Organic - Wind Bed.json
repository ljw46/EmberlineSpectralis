{
    "name": "Wind Bed",
    "category": "Organic",
    "description": "Whistling wind: bandpassed white noise drifting slowly in pitch. Spooky and spacious.",
    "tags": ["organic", "wind", "noise", "spacious"],
    "macro_names": ["Brightness", "-", "Focus", "-"],
    "parameters": {
        "master_volume": 1.8,
        "osc1_on": false,
        "osc1_frame": 0.0,
        "osc1_level": 0.0,
        "noise_level": 0.8,
        "noise_type": "White",
        "filt1_type": "Bandpass",
        "filt1_cutoff": 1400,
        "filt1_res": 0.5,
        "env1_attack": 1.5,
        "env1_decay": 1.0,
        "env1_sustain": 0.9,
        "env1_release": 2.5,
        "lfo1_rate": 0.17,
        "lfo1_mode": "Free",
        "lfo2_rate": 0.23,
        "lfo2_mode": "Free",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.35,
        "fx_reverb_size": 0.8,
        "fx_reverb_decay": 5.0,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "LFO 1", "destination": "Filt1 Cutoff", "depth": 0.15},
        {"source": "Perlin", "destination": "Filt1 Cutoff", "depth": 0.1},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.0},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.3},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.0}
    ]
}
