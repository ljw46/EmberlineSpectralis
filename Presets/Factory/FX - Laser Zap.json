{
    "name": "Laser Zap",
    "category": "FX",
    "description": "A fast, bright sync-warp zap. Percussive sci-fi blip, great for fills and risers' end hits.",
    "tags": ["fx", "laser", "zap", "sci-fi"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": 6.0,
        "osc1_on": true,
        "osc1_frame": 0.9,
        "osc1_level": 0.8,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 9000,
        "filt1_res": 0.3,
        "env1_attack": 0.001,
        "env1_decay": 0.25,
        "env1_sustain": 0.0,
        "env1_release": 0.1,
        "env1_dcurve": 0.6,
        "env2_attack": 0.001,
        "env2_decay": 0.2,
        "env2_sustain": 0.0,
        "env2_release": 0.1,
        "env2_dcurve": 0.6,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.4,
        "fx_delay_tone": 6000,
        "fx_delay_mix": 0.25,
        "fx_delay_sync": "1/16",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.2,
        "fx_reverb_size": 0.5,
        "fx_reverb_decay": 2.0,
        "fx_reverb_damp": 0.4,
        "osc1_table": "Saw Sync"
    },
    "modulation": [
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.2},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.0},
        {"source": "ENV 2", "destination": "Osc1 Frame", "depth": -0.7}
    ]
}
