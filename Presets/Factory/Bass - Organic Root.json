        "osc1_frame": 0.1,
        "osc1_level": 0.85,
        "osc2_on": true,
        "osc2_table": "Mallet",
        "osc2_frame": 0.4,
        "osc2_level": 0.2,
        "osc2_semi": 12,
        "osc2_pan": 0.1,
        "sub_level": 0.25,
        "sub_wave": "Sine",
        "sub_oct": "-1 Oct",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 800,
        "filt1_res": 0.12,
        "env1_attack": 0.004,
        "env1_decay": 0.45,
        "env1_sustain": 0.6,
        "env1_release": 0.2,
        "fx_dist_on": true,
