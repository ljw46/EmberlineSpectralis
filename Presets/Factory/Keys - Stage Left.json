{
    "name": "Stage Left",
    "category": "Keys",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A layered piano and electric piano panned apart - the grand on the left, the Wurlitzer on the right - for a wide, played-in-a-room stereo image that glues itself together.",
    "tags": ["keys", "layered", "stereo", "piano", "wide"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": 1.4,
        "osc1_on": true,
        "osc1_table": "Grand Piano",
        "osc1_frame": 0.4,
        "osc1_level": 0.8,
        "osc1_pan": -0.45,
        "osc2_on": true,
        "osc2_table": "Electric Piano",
        "osc2_frame": 0.4,
        "osc2_level": 0.65,
        "osc2_pan": 0.45,
        "osc3_on": true,
        "osc3_table": "Mallet",
        "osc3_frame": 0.3,
        "osc3_level": 0.15,
        "osc3_semi": 12,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 5000,
        "filt1_res": 0.1,
        "env1_attack": 0.003,
        "env1_decay": 1.4,
        "env1_sustain": 0.15,
        "env1_release": 0.7,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.28,
        "fx_reverb_size": 0.65,
        "fx_reverb_decay": 3.4,
        "fx_reverb_damp": 0.45,
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.15,
        "fx_chorus_rate": 0.3,
        "fx_chorus_depth": 0.35,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.3,
        "fx_delay_tone": 4000,
        "fx_delay_mix": 0.14,
        "fx_delay_sync": "1/8."
    },
    "modulation": [
        {"source": "Velocity", "destination": "Osc2 Frame", "depth": 0.3},
        {"source": "Perlin", "destination": "Osc1 Pan", "depth": 0.1},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc2 Frame", "depth": 0.4},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.22},
        {"source": "Velocity", "destination": "Osc1 Frame", "depth": 0.3},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Aftertouch", "destination": "Osc3 Level", "depth": 0.25}
    ]
