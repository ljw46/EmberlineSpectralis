{
    "name": "Pulse Width Bass",
    "category": "Bass",
    "description": "A PWM bass: slowly modulated pulse width gives movement without any filter motion. Warm and analogue.",
    "tags": ["bass", "pwm", "analog", "wavetable"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": -2.0,
        "osc1_table": "Pulse Width",
        "osc1_on": true,
        "osc1_frame": 0.3,
        "osc1_level": 0.8,
        "osc2_on": true,
        "osc2_frame": 0.1,
        "osc2_level": 0.5,
        "osc2_semi": -12,
        "osc2_table": "Pulse Width",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 1100,
        "filt1_res": 0.2,
        "env1_attack": 0.003,
        "env1_decay": 0.3,
        "env1_sustain": 0.85,
        "env1_release": 0.15,
        "lfo1_rate": 0.5,
        "lfo1_mode": "Free"
    },
    "modulation": [
        {"source": "LFO 1", "destination": "Osc1 Frame", "depth": 0.25},
        {"source": "LFO 1", "destination": "Osc2 Frame", "depth": -0.2},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.3},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.0}
    ],
    "lfo_shapes": {"lfo1": "sine"}
}
