{
    "name": "Sugar Glass",
    "category": "Pluck",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A sparkling, sharp-edged pluck from a plucked-string algorithm table plus glass harmonics, thrown through a triplet echo. Candy-bright and very danceable.",
    "tags": ["pluck", "bright", "sparkle", "triplet", "melodic house"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": 1.8,
        "osc1_on": true,
        "osc1_table": "Pluck Algorithm",
        "osc1_frame": 0.6,
        "osc1_level": 0.8,
        "osc1_unison": 2,
        "osc1_detune": 5,
        "osc1_spread": 0.5,
        "osc1_pan": -0.12,
        "osc2_on": true,
        "osc2_table": "Glass Harmonics",
        "osc2_frame": 0.4,
        "osc2_level": 0.3,
        "osc2_semi": 12,
        "osc2_pan": 0.15,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 7500,
        "filt1_res": 0.12,
        "env1_attack": 0.001,
        "env1_decay": 0.4,
        "env1_sustain": 0.0,
        "env1_release": 0.25,
        "env1_dcurve": 0.5,
        "env2_attack": 0.001,
        "env2_decay": 0.2,
        "env2_sustain": 0.0,
        "env2_release": 0.15,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.45,
        "fx_delay_tone": 6200,
        "fx_delay_mix": 0.3,
        "fx_delay_sync": "1/16T",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.22,
        "fx_reverb_size": 0.55,
        "fx_reverb_decay": 2.8,
        "fx_reverb_damp": 0.3
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Osc1 Frame", "depth": -0.3, "bipolar": false},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.2},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Aftertouch", "destination": "Osc2 Frame", "depth": 0.2}
    ]
}
