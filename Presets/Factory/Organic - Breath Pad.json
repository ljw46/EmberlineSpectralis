{
    "name": "Breath Pad",
    "category": "Organic",
    "description": "A pad made mostly of filtered breath noise with a faint pitched core. Like wind through a flute.",
    "tags": ["organic", "breath", "noise", "pad"],
    "macro_names": ["Brightness", "Tone", "Focus", "-"],
    "parameters": {
        "master_volume": 4.8,
        "osc1_on": true,
        "osc1_frame": 0.1,
        "osc1_level": 0.8,
        "noise_level": 0.9,
        "noise_type": "Pink",
        "filt1_type": "Bandpass",
        "filt1_cutoff": 1500,
        "filt1_res": 0.4,
        "env1_attack": 1.0,
        "env1_decay": 1.0,
        "env1_sustain": 0.85,
        "env1_release": 2.0,
        "lfo1_rate": 0.2,
        "lfo1_mode": "Free",
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.25,
        "fx_chorus_rate": 0.3,
        "fx_chorus_depth": 0.4,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.4,
        "fx_reverb_size": 0.8,
        "fx_reverb_decay": 5.0,
        "fx_reverb_damp": 0.3
    },
    "modulation": [
        {"source": "LFO 1", "destination": "Filt1 Cutoff", "depth": 0.12},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.2},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.3},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.0}
    ]
}
