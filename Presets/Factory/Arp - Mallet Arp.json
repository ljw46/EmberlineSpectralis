{
    "name": "Mallet Arp",
    "category": "Arp",
    "description": "A tuned-mallet arp voice: marimba-style partials with a short decay. Wooden and rhythmic.",
    "tags": ["arp", "mallet", "marimba", "wavetable"],
    "macro_names": ["Brightness", "Partials", "Resonance", "Width"],
    "parameters": {
        "master_volume": 2.3,
        "osc1_table": "Mallet",
        "osc1_on": true,
        "osc1_frame": 0.55,
        "osc1_level": 0.85,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 6000,
        "filt1_res": 0.1,
        "env1_attack": 0.001,
        "env1_decay": 0.25,
        "env1_sustain": 0.0,
        "env1_release": 0.15,
        "env1_dcurve": 0.5,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.4,
        "fx_delay_tone": 5000,
        "fx_delay_mix": 0.25,
        "fx_delay_sync": "1/8.",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.2,
        "fx_reverb_size": 0.5,
        "fx_reverb_decay": 2.2,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.2},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.3}
    ]
}
