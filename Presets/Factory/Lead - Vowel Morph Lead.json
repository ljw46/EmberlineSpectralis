{
    "name": "Vowel Morph Lead",
    "category": "Lead",
    "description": "A lead that speaks: the Vowel Sweep table with Macro 2 gliding A-E-I-O-U. Perform the vowel with the macro or automate it.",
    "tags": ["lead", "vocal", "vowel", "wavetable", "performance"],
    "macro_names": ["Brightness", "Vowel", "Resonance", "Width"],
    "parameters": {
        "master_volume": 5.0,
        "osc1_table": "Vowel Sweep",
        "osc1_frame": 0.0,
        "osc1_on": true,
        "osc1_level": 0.85,
        "osc1_unison": 3,
        "osc1_detune": 9,
        "osc1_spread": 0.6,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 7000,
        "filt1_res": 0.15,
        "env1_attack": 0.02,
        "env1_decay": 0.3,
        "env1_sustain": 0.85,
        "env1_release": 0.4,
        "lfo2_rate": 5.0,
        "lfo2_mode": "Free",
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.25,
        "fx_chorus_rate": 0.4,
        "fx_chorus_depth": 0.4,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.35,
        "fx_delay_tone": 5000,
        "fx_delay_mix": 0.2,
        "fx_delay_sync": "1/8.",
