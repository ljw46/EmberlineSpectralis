{
    "name": "Gravity Well",
    "category": "FX",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "The opposite of a riser: noise and a detuned stack that collapse downward as the filter closes, falling into a deep reverb. Drops onto the downbeat as a tail or a breakdown pull.",
    "tags": ["fx", "downlifter", "fall", "tail", "transition"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": 6.0,
        "noise_level": 0.7,
        "noise_type": "White",
        "osc1_on": true,
        "osc1_table": "Blended Waves",
        "osc1_frame": 0.5,
        "osc1_level": 0.55,
        "osc1_unison": 5,
        "osc1_detune": 20,
        "osc1_spread": 1.0,
        "osc1_pan": -0.2,
        "osc2_on": true,
        "osc2_table": "Bass Weight",
        "osc2_frame": 0.2,
        "osc2_level": 0.4,
        "osc2_semi": -12,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 12000,
        "filt1_res": 0.3,
        "env1_attack": 0.01,
        "env1_decay": 4.5,
        "env1_sustain": 0.0,
        "env1_release": 2.5,
        "env1_dcurve": 0.2,
        "env2_attack": 0.005,
        "env2_decay": 4.0,
        "env2_sustain": 0.0,
        "env2_release": 1.0,
        "env2_dcurve": 0.3,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.34,
        "fx_reverb_size": 0.75,
        "fx_reverb_decay": 4.5,
        "fx_reverb_damp": 0.4,
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.2,
        "fx_chorus_rate": 0.3,
        "fx_chorus_depth": 0.5
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Filt1 Cutoff", "depth": -0.536},
        {"source": "ENV 2", "destination": "Osc1 Fine", "depth": -0.5, "bipolar": false},
        {"source": "Perlin", "destination": "Osc1 Pan", "depth": 0.3},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Aftertouch", "destination": "Reverb Mix", "depth": 0.2},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.1}
    ]
}
