{
    "name": "Fire Crackle",
    "category": "Organic",
    "description": "A warm, low crackling fire bed with a faint drone beneath.",
    "tags": ["organic", "fire", "crackle", "warm"],
    "macro_names": ["Brightness", "Drone", "-", "-"],
    "parameters": {
        "master_volume": 4.7,
        "osc1_on": true,
        "osc1_frame": 0.1,
        "osc1_level": 0.2,
        "noise_level": 0.55,
        "noise_type": "Crackle",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 2500,
        "filt1_res": 0.2,
        "env1_attack": 1.0,
        "env1_decay": 1.0,
        "env1_sustain": 0.9,
        "env1_release": 2.0,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.25,
        "fx_reverb_size": 0.6,
        "fx_reverb_decay": 2.8,
        "fx_reverb_damp": 0.5
    },
    "modulation": [
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.2},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.2},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.0}
    ]
}
