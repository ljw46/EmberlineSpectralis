{
    "name": "Saw Lead",
    "category": "Lead",
    "description": "Confident detuned saw lead with a touch of vibrato, chorus and delay. The melodic-house everyman.",
    "tags": ["lead", "saw", "melodic house"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": 0.0,
        "osc1_on": true,
        "osc1_frame": 0.5,
        "osc1_level": 0.8,
        "osc1_unison": 3,
        "osc1_detune": 12,
        "osc1_spread": 0.6,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 4500,
        "filt1_res": 0.2,
        "env1_attack": 0.008,
        "env1_decay": 0.3,
        "env1_sustain": 0.8,
        "env1_release": 0.3,
        "lfo2_rate": 5.2,
        "lfo2_mode": "Free",
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.25,
        "fx_chorus_rate": 0.5,
        "fx_chorus_depth": 0.4,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.35,
        "fx_delay_tone": 5000,
        "fx_delay_mix": 0.22,
        "fx_delay_sync": "1/8.",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.2,
        "fx_reverb_size": 0.55,
        "fx_reverb_decay": 2.6,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "LFO 2", "destination": "Osc1 Fine", "depth": 0.03},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.4},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5}
    ]
}
