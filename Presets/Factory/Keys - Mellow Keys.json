{
    "name": "Mellow Keys",
    "category": "Keys",
    "description": "Dark, mellow keys with the top end rolled off. Lovely for late-night chords.",
    "tags": ["keys", "mellow", "dark", "late night"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": 0.7,
        "osc1_on": true,
        "osc1_frame": 0.22,
        "osc1_level": 0.8,
        "osc1_unison": 2,
        "osc1_detune": 6,
        "osc1_spread": 0.5,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 1400,
        "filt1_res": 0.1,
        "env1_attack": 0.005,
        "env1_decay": 1.0,
        "env1_sustain": 0.3,
        "env1_release": 0.6,
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.3,
        "fx_chorus_rate": 0.4,
        "fx_chorus_depth": 0.4,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.25,
        "fx_reverb_size": 0.6,
        "fx_reverb_decay": 3.0,
        "fx_reverb_damp": 0.5
    },
    "modulation": [
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.3},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.2},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.3}
    ]
}
