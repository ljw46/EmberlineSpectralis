{
    "name": "Chaos Burst",
    "category": "FX",
    "description": "A burst of Lorenz-driven noise and tone that decays into silence. Unpredictable, every note different.",
    "tags": ["fx", "chaos", "burst", "random"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": 4.2,
        "osc1_on": true,
        "osc1_frame": 0.5,
        "osc1_level": 0.5,
        "osc1_unison": 4,
        "osc1_detune": 30,
        "osc1_spread": 0.5,
        "noise_level": 0.3,
        "noise_type": "White",
        "filt1_type": "Bandpass",
        "filt1_cutoff": 1500,
        "filt1_res": 0.5,
        "env1_attack": 0.001,
        "env1_decay": 1.8,
        "env1_sustain": 0.0,
        "env1_release": 1.0,
        "env1_dcurve": 0.3,
        "fx_dist_on": true,
        "fx_dist_type": "Hard",
        "fx_dist_drive": 0.3,
        "fx_dist_tone": 0.6,
        "fx_dist_mix": 0.4,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.5,
        "fx_delay_tone": 6000,
        "fx_delay_mix": 0.3,
        "fx_delay_sync": "1/16",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.35,
        "fx_reverb_size": 0.8,
        "fx_reverb_decay": 5.0,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "Chaos X", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Chaos Z", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Chaos Y", "destination": "Osc1 Pan", "depth": 0.9},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.3},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.3}
    ]
}
