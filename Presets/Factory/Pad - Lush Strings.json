{
    "name": "Lush Strings",
    "category": "Pad",
    "description": "String-ensemble pad: stacked detuned saws with a gentle attack and generous chorus.",
    "tags": ["pad", "strings", "ensemble", "lush"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": 1.8,
        "osc1_on": true,
        "osc1_frame": 0.5,
        "osc1_level": 0.65,
        "osc1_unison": 6,
        "osc1_detune": 18,
        "osc1_spread": 0.9,
        "osc2_on": true,
        "osc2_frame": 0.5,
        "osc2_level": 0.45,
        "osc2_unison": 4,
        "osc2_detune": 14,
        "osc2_spread": 0.8,
        "osc2_semi": 12,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 3200,
        "filt1_res": 0.1,
        "env1_attack": 0.5,
        "env1_decay": 0.8,
        "env1_sustain": 0.85,
        "env1_release": 1.2,
        "env1_acurve": -0.2,
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.45,
        "fx_chorus_rate": 0.45,
        "fx_chorus_depth": 0.6,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.3,
        "fx_reverb_size": 0.7,
        "fx_reverb_decay": 4.0,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.2},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.6}
    ]
}
