{
    "name": "Whoosh",
    "category": "FX",
    "description": "A short noise swish that opens and closes: a quick bandpass sweep for transitions between phrases.",
    "tags": ["fx", "whoosh", "swish", "transition"],
    "macro_names": ["Brightness", "-", "Focus", "-"],
    "parameters": {
        "master_volume": 4.9,
        "osc1_on": false,
        "osc1_frame": 0.0,
        "osc1_level": 0.0,
        "noise_level": 1.0,
        "noise_type": "White",
        "filt1_type": "Bandpass",
        "filt1_cutoff": 500,
        "filt1_res": 0.4,
        "env1_attack": 0.6,
        "env1_decay": 0.8,
        "env1_sustain": 0.0,
        "env1_release": 0.6,
        "env2_attack": 0.6,
        "env2_decay": 0.8,
        "env2_sustain": 0.0,
        "env2_release": 0.6,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.25,
        "fx_reverb_size": 0.6,
        "fx_reverb_decay": 2.2,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Filt1 Cutoff", "depth": 0.401},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.0},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.3},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.0}
    ]
}
