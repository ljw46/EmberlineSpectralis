{
    "name": "Kalimba",
    "category": "Organic",
    "description": "Thumb-piano pluck: bright sine with a high partial and a quick wooden decay. Intimate and warm.",
    "tags": ["organic", "kalimba", "thumb piano", "pluck"],
    "macro_names": ["Brightness", "Tone", "-", "Shimmer"],
    "parameters": {
        "master_volume": -3.5,
        "osc1_on": true,
        "osc1_frame": 0.0,
        "osc1_level": 0.8,
        "osc2_on": true,
        "osc2_frame": 0.0,
        "osc2_level": 0.3,
        "osc2_semi": 24,
        "osc3_on": true,
        "osc3_frame": 0.1,
        "osc3_level": 0.15,
        "osc3_semi": 24,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 5500,
        "filt1_res": 0.1,
        "env1_attack": 0.001,
        "env1_decay": 0.7,
        "env1_sustain": 0.0,
        "env1_release": 0.5,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.25,
        "fx_reverb_size": 0.55,
        "fx_reverb_decay": 2.4,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.2},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.1},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.2}
    ]
}
