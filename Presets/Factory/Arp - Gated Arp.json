{
    "name": "Gated Arp",
    "category": "Arp",
    "description": "A sustained tone chopped into sixteenth-note pulses by a host-synced gate. Hold a chord for instant rhythm.",
    "tags": ["arp", "gated", "synced", "rhythmic"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": -3.1,
        "osc1_on": true,
        "osc1_frame": 0.5,
        "osc1_level": 0.4,
        "osc1_unison": 3,
        "osc1_detune": 12,
        "osc1_spread": 0.7,
        "osc2_on": true,
        "osc2_frame": 0.3,
        "osc2_level": 0.3,
        "osc2_semi": 12,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 3500,
        "filt1_res": 0.2,
        "env1_attack": 0.003,
        "env1_decay": 0.2,
        "env1_sustain": 0.9,
        "env1_release": 0.08,
        "lfo3_sync": "1/16",
        "lfo3_mode": "Free",
        "fx_delay_on": true,
        "fx_delay_feedback": 0.35,
        "fx_delay_tone": 5000,
        "fx_delay_mix": 0.2,
        "fx_delay_sync": "1/8.",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.2,
        "fx_reverb_size": 0.5,
        "fx_reverb_decay": 2.4,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "LFO 3", "destination": "Osc1 Level", "depth": 0.4},
        {"source": "LFO 3", "destination": "Osc2 Level", "depth": 0.4},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.4},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5}
    ],
    "lfo_shapes": {"lfo3": "square"}
}
