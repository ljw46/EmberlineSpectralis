{
    "name": "Lorenz Cloud",
    "category": "Texture",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A cloud of voices and random spectra steered entirely by the Lorenz attractor: every axis moves a different part of the sound - filter, wave position, level and stereo - so the cloud morphs and never repeats.",
    "tags": ["texture", "chaos", "lorenz", "voice", "generative"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": 3.7,
        "osc1_on": true,
        "osc1_table": "Human Voice",
        "osc1_frame": 0.4,
        "osc1_level": 0.65,
        "osc1_unison": 4,
        "osc1_detune": 14,
        "osc1_spread": 1.0,
        "osc1_pan": -0.2,
        "osc2_on": true,
        "osc2_table": "Noise Morph",
        "osc2_frame": 0.5,
        "osc2_level": 0.5,
        "osc2_unison": 3,
        "osc2_detune": 12,
        "osc2_spread": 0.9,
        "osc2_semi": 7,
        "osc2_pan": 0.2,
        "osc3_on": true,
        "osc3_table": "Glass Harmonics",
        "osc3_frame": 0.4,
        "osc3_level": 0.2,
        "osc3_semi": 12,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 3200,
        "filt1_res": 0.25,
        "env1_attack": 1.4,
        "env1_decay": 1.0,
        "env1_sustain": 0.85,
        "env1_release": 3.0,
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.25,
        "fx_chorus_rate": 0.28,
        "fx_chorus_depth": 0.5,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.45,
        "fx_reverb_size": 0.85,
        "fx_reverb_decay": 6.5,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "Chaos X", "destination": "Filt1 Cutoff", "depth": 0.2},
        {"source": "Chaos Y", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Chaos Z", "destination": "Osc2 Frame", "depth": 0.4},
        {"source": "Chaos X", "destination": "Osc1 Pan", "depth": 0.5},
        {"source": "Chaos Y", "destination": "Osc2 Pan", "depth": -0.5},
        {"source": "Chaos Z", "destination": "Osc3 Level", "depth": 0.15},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc2 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.08},
        {"source": "Mod Wheel", "destination": "Reverb Mix", "depth": 0.3},
        {"source": "Aftertouch", "destination": "Osc1 Frame", "depth": 0.2}
    ]
}
