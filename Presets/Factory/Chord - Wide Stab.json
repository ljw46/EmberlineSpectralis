{
    "name": "Wide Stab",
    "category": "Chord",
    "description": "A very wide stab with three layered oscillators for open, anthemic chords.",
    "tags": ["stab", "wide", "anthemic", "chord"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": 2.1,
        "osc1_on": true,
        "osc1_frame": 0.5,
        "osc1_level": 0.6,
        "osc1_unison": 6,
        "osc1_detune": 22,
        "osc1_spread": 1.0,
        "osc2_on": true,
        "osc2_frame": 0.5,
        "osc2_level": 0.5,
        "osc2_unison": 5,
        "osc2_detune": 18,
        "osc2_spread": 1.0,
        "osc2_semi": 12,
        "osc3_on": true,
        "osc3_frame": 0.25,
        "osc3_level": 0.4,
        "osc3_unison": 3,
        "osc3_detune": 12,
        "osc3_spread": 0.5,
        "osc3_semi": -12,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 2200,
        "filt1_res": 0.2,
        "env1_attack": 0.003,
        "env1_decay": 0.4,
        "env1_sustain": 0.0,
        "env1_release": 0.3,
        "env1_dcurve": 0.5,
        "env2_attack": 0.001,
        "env2_decay": 0.3,
        "env2_sustain": 0.0,
        "env2_release": 0.25,
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.25,
        "fx_chorus_rate": 0.4,
        "fx_chorus_depth": 0.5,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.28,
        "fx_reverb_size": 0.65,
        "fx_reverb_decay": 3.2,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Filt1 Cutoff", "depth": 0.244},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.3},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.6}
    ]
}
