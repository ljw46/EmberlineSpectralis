{
    "name": "Warehouse Stab",
    "category": "Chord",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "The peak-time house stab: bright detuned waves with a hard-sync layer, a quick filter snap and a dotted echo. Sharp, wide and made to be played on the offbeat.",
    "tags": ["stab", "house", "warehouse", "bright", "classic"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": 1.9,
        "osc1_on": true,
        "osc1_table": "Blended Waves",
        "osc1_frame": 0.6,
        "osc1_level": 0.75,
        "osc1_unison": 4,
        "osc1_detune": 15,
        "osc1_spread": 0.8,
        "osc1_pan": -0.15,
        "osc2_on": true,
        "osc2_table": "Saw Sync",
        "osc2_frame": 0.15,
        "osc2_level": 0.4,
        "osc2_unison": 3,
        "osc2_detune": 11,
        "osc2_spread": 0.7,
        "osc2_pan": 0.18,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 1700,
        "filt1_res": 0.25,
        "env1_attack": 0.002,
        "env1_decay": 0.3,
        "env1_sustain": 0.0,
        "env1_release": 0.22,
        "env1_dcurve": 0.5,
        "env2_attack": 0.001,
        "env2_decay": 0.26,
        "env2_sustain": 0.0,
        "env2_release": 0.2,
        "env2_dcurve": 0.5,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.42,
        "fx_delay_tone": 4500,
        "fx_delay_mix": 0.26,
        "fx_delay_sync": "1/8.",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.2,
        "fx_reverb_size": 0.5,
        "fx_reverb_decay": 2.4,
        "fx_reverb_damp": 0.4,
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.15,
        "fx_chorus_rate": 0.4,
        "fx_chorus_depth": 0.4
