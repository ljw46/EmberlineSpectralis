{
    "name": "Vocal Chop Chord",
    "category": "Chord",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A chord of 'ooh's: recorded voices on a snappy envelope with a formant sweep that opens on every hit. Sounds like a sampled vocal stab without a sample in sight.",
    "tags": ["stab", "vocal", "voice", "chop", "house"],
    "macro_names": ["Brightness", "Vowel", "Space", "Width"],
    "parameters": {
        "master_volume": 5.4,
        "osc1_on": true,
        "osc1_table": "Human Voice",
        "osc1_frame": 0.3,
        "osc1_level": 0.75,
        "osc1_unison": 3,
        "osc1_detune": 9,
        "osc1_spread": 0.8,
        "osc1_pan": -0.15,
        "osc2_on": true,
        "osc2_table": "Vowel Sweep",
        "osc2_frame": 0.2,
        "osc2_level": 0.45,
        "osc2_unison": 2,
        "osc2_detune": 7,
        "osc2_spread": 0.5,
        "osc2_semi": 12,
        "osc2_pan": 0.18,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 3500,
        "filt1_res": 0.2,
        "env1_attack": 0.003,
        "env1_decay": 0.4,
        "env1_sustain": 0.0,
        "env1_release": 0.3,
        "env1_dcurve": 0.5,
        "env2_attack": 0.001,
        "env2_decay": 0.25,
        "env2_sustain": 0.0,
        "env2_release": 0.2,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.35,
        "fx_delay_tone": 4500,
        "fx_delay_mix": 0.2,
        "fx_delay_sync": "1/8",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.3,
        "fx_reverb_size": 0.65,
        "fx_reverb_decay": 3.0,
        "fx_reverb_damp": 0.4,
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.2,
        "fx_chorus_rate": 0.4,
        "fx_chorus_depth": 0.4
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "ENV 2", "destination": "Osc2 Frame", "depth": 0.6},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc2 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.22},
        {"source": "Velocity", "destination": "Osc1 Level", "depth": 0.2},
        {"source": "Mod Wheel", "destination": "Osc2 Frame", "depth": 0.4},
        {"source": "Aftertouch", "destination": "Osc1 Frame", "depth": 0.2}
    ]
}
