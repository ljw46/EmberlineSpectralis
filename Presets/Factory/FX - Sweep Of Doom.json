{
    "name": "Sweep Of Doom",
    "category": "FX",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A long, resonant filter sweep over a dark saw stack, driven by a four-bar triangle LFO locked to the host. Automate Macro 1 by hand to ride it.",
    "tags": ["fx", "sweep", "filter", "synced", "dark"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": -3.1,
        "osc1_on": true,
        "osc1_table": "Blended Waves",
        "osc1_frame": 0.4,
        "osc1_level": 0.6,
        "osc1_unison": 5,
        "osc1_detune": 18,
        "osc1_spread": 0.9,
        "osc1_pan": -0.2,
        "osc2_on": true,
        "osc2_table": "Distorted",
        "osc2_frame": 0.3,
        "osc2_level": 0.4,
        "osc2_unison": 3,
        "osc2_detune": 13,
        "osc2_spread": 0.5,
        "osc2_semi": -12,
        "osc2_pan": 0.2,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 450,
        "filt1_res": 0.55,
        "filt1_drive": 0.15,
        "env1_attack": 0.1,
        "env1_decay": 1.0,
        "env1_sustain": 1.0,
        "env1_release": 1.2,
        "lfo1_sync": "4 bars",
        "lfo1_mode": "Free",
        "fx_dist_on": true,
        "fx_dist_type": "Soft",
        "fx_dist_drive": 0.25,
        "fx_dist_tone": 0.4,
        "fx_dist_mix": 0.4,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.28,
        "fx_reverb_size": 0.65,
        "fx_reverb_decay": 3.0,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "LFO 1", "destination": "Filt1 Cutoff", "depth": 0.38},
        {"source": "LFO 1", "destination": "Filt1 Res", "depth": 0.12},
        {"source": "Perlin", "destination": "Osc2 Frame", "depth": 0.3},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Aftertouch", "destination": "Reverb Mix", "depth": 0.2},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.1}
    ],
    "lfo_shapes": {"lfo1": "triangle"}
}
