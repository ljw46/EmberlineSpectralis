{
    "name": "Rumble Floor",
    "category": "Bass",
    "description": "Very low, dark rumble with a trace of noise for a subterranean bed under breakdowns.",
    "tags": ["bass", "rumble", "dark", "low"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": -1.9,
        "osc1_on": true,
        "osc1_frame": 0.1,
        "osc1_level": 0.7,
        "sub_level": 0.6,
        "sub_wave": "Sine",
        "sub_oct": "-2 Oct",
        "noise_level": 0.05,
        "noise_type": "Pink",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 260,
        "filt1_res": 0.1,
        "env1_attack": 0.05,
        "env1_decay": 0.5,
        "env1_sustain": 0.9,
        "env1_release": 0.5,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.12,
        "fx_reverb_size": 0.5,
        "fx_reverb_decay": 2.0,
        "fx_reverb_damp": 0.7
    },
    "modulation": [
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.2},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.1},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.0}
    ]
}
