{
    "name": "Warm Tube Bass",
    "category": "Bass",
    "description": "Rounded analogue-style bass. Triangle body, sub layer and tube saturation for warmth.",
    "tags": ["bass", "warm", "tube", "analog"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": -3.5,
        "osc1_on": true,
        "osc1_frame": 0.3,
        "osc1_level": 0.8,
        "sub_level": 0.4,
        "sub_wave": "Sine",
        "sub_oct": "-1 Oct",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 900,
        "filt1_res": 0.15,
        "filt1_drive": 0.25,
        "env1_attack": 0.003,
        "env1_decay": 0.35,
        "env1_sustain": 0.8,
        "env1_release": 0.18,
        "fx_dist_on": true,
        "fx_dist_type": "Tube",
        "fx_dist_drive": 0.35,
        "fx_dist_tone": 0.5,
        "fx_dist_mix": 0.5
    },
    "modulation": [
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.2},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.0}
    ]
}
