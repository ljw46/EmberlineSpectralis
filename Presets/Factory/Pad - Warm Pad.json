{
    "name": "Warm Pad",
    "category": "Pad",
    "description": "The go-to warm pad: detuned saws and triangles through a soft lowpass, with slow chorus and a roomy reverb.",
    "tags": ["pad", "warm", "classic", "melodic house"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": 0.3,
        "osc1_on": true,
        "osc1_frame": 0.45,
        "osc1_level": 0.7,
        "osc1_unison": 4,
        "osc1_detune": 16,
        "osc1_spread": 0.85,
        "osc2_on": true,
        "osc2_frame": 0.2,
        "osc2_level": 0.5,
        "osc2_unison": 3,
        "osc2_detune": 10,
        "osc2_spread": 0.7,
        "osc2_fine": 3,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 2400,
        "filt1_res": 0.15,
        "env1_attack": 0.9,
        "env1_decay": 1.0,
        "env1_sustain": 0.8,
        "env1_release": 1.6,
        "env1_acurve": -0.2,
        "lfo1_rate": 0.12,
        "lfo1_mode": "Free",
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.35,
        "fx_chorus_rate": 0.3,
        "fx_chorus_depth": 0.55,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.35,
        "fx_reverb_size": 0.75,
        "fx_reverb_decay": 5.0,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "LFO 1", "destination": "Filt1 Cutoff", "depth": 0.06},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.3},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.6}
    ]
}
