{
    "name": "Evolving Pad",
    "category": "Pad",
    "description": "A pad in constant, non-repeating motion: LFOs move the filter and wave position while Perlin noise drifts the pan.",
    "tags": ["pad", "evolving", "movement", "organic"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": -1.0,
        "osc1_on": true,
        "osc1_frame": 0.4,
        "osc1_level": 0.65,
        "osc1_unison": 4,
        "osc1_detune": 16,
        "osc1_spread": 0.9,
        "osc2_on": true,
        "osc2_frame": 0.6,
        "osc2_level": 0.45,
        "osc2_unison": 3,
        "osc2_detune": 12,
        "osc2_spread": 0.8,
        "osc2_semi": 7,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 1800,
        "filt1_res": 0.25,
        "env1_attack": 1.4,
        "env1_decay": 1.0,
        "env1_sustain": 0.85,
        "env1_release": 2.2,
        "lfo1_rate": 0.1,
        "lfo1_mode": "Free",
        "lfo2_rate": 0.17,
        "lfo2_mode": "Free",
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.3,
        "fx_chorus_rate": 0.3,
        "fx_chorus_depth": 0.5,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.4,
        "fx_reverb_size": 0.8,
        "fx_reverb_decay": 6.0,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "LFO 1", "destination": "Filt1 Cutoff", "depth": 0.12},
        {"source": "LFO 2", "destination": "Osc1 Frame", "depth": 0.2},
        {"source": "Perlin", "destination": "Osc1 Pan", "depth": 0.4},
        {"source": "S&H", "destination": "Osc2 Frame", "depth": 0.05},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.3},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5}
    ]
}
