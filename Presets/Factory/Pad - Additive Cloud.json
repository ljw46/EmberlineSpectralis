{
    "name": "Additive Cloud",
    "category": "Pad",
    "description": "A pad built by adding harmonics one at a time: Macro 2 or the LFO fills in the spectrum like a cloud thickening.",
    "tags": ["pad", "additive", "harmonics", "wavetable"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": 0.9,
        "osc1_table": "Additive Build",
        "osc2_table": "Additive Build",
        "osc2_on": true,
        "osc1_on": true,
        "osc1_frame": 0.2,
        "osc1_level": 0.65,
        "osc1_unison": 4,
        "osc1_detune": 12,
        "osc1_spread": 0.9,
        "osc2_frame": 0.5,
        "osc2_level": 0.45,
        "osc2_unison": 3,
        "osc2_detune": 9,
        "osc2_spread": 0.8,
        "osc2_semi": 7,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 7000,
        "filt1_res": 0.1,
        "env1_attack": 1.4,
        "env1_decay": 1.0,
        "env1_sustain": 0.85,
        "env1_release": 2.4,
        "lfo1_rate": 0.08,
        "lfo1_mode": "Free",
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.35,
        "fx_chorus_rate": 0.3,
        "fx_chorus_depth": 0.5,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.4,
        "fx_reverb_size": 0.8,
        "fx_reverb_decay": 6.0,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "LFO 1", "destination": "Osc1 Frame", "depth": 0.4, "bipolar": false},
        {"source": "LFO 1", "destination": "Osc2 Frame", "depth": 0.3, "bipolar": false},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.2},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5}
    ]
}
