{
    "name": "Sync Pluck",
    "category": "Pluck",
    "description": "Hard-sync sweep on every note gives a laser-like, vintage-synth pluck.",
    "tags": ["pluck", "sync", "retro", "sweep"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": 3.6,
        "osc1_on": true,
        "osc1_frame": 0.5,
        "osc1_level": 0.8,
        "osc1_warp_mode": "Sync",
        "osc1_warp_amt": 0.1,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 2600,
        "filt1_res": 0.2,
        "env1_attack": 0.001,
        "env1_decay": 0.4,
        "env1_sustain": 0.0,
        "env1_release": 0.2,
        "env1_dcurve": 0.5,
        "env2_attack": 0.001,
        "env2_decay": 0.3,
        "env2_sustain": 0.0,
        "env2_release": 0.2,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.3,
        "fx_delay_tone": 5000,
        "fx_delay_mix": 0.2,
        "fx_delay_sync": "1/8"
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Osc1 Warp", "depth": 0.5},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.4},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5}
    ]
}
