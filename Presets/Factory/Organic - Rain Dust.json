{
    "name": "Rain Dust",
    "category": "Organic",
    "description": "Fine crackle like rain on a window. A sparse, tactile noise bed for lo-fi sections.",
    "tags": ["organic", "rain", "crackle", "lo-fi"],
    "macro_names": ["Brightness", "-", "-", "-"],
    "parameters": {
        "master_volume": 3.1,
        "noise_level": 1.0,
        "noise_type": "Crackle",
        "osc1_on": true,
        "osc1_frame": 0.4,
        "osc1_level": 0.5,
        "osc1_unison": 3,
        "osc1_detune": 14,
        "osc1_spread": 0.5,
        "filt1_type": "Highpass",
        "filt1_cutoff": 500,
        "filt1_res": 0.1,
        "env1_attack": 0.5,
        "env1_decay": 1.0,
        "env1_sustain": 0.9,
        "env1_release": 1.5,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.3,
        "fx_reverb_size": 0.7,
        "fx_reverb_decay": 3.0,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.0},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.1},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.0}
    ]
}
