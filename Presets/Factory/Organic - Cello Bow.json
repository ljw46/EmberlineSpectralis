{
    "name": "Cello Bow",
    "category": "Organic",
    "description": "Warm, bowed-string tone: a slow attack saw with slight vibrato and a dark lowpass.",
    "tags": ["organic", "cello", "bowed", "string"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": -1.6,
        "osc1_on": true,
        "osc1_frame": 0.5,
        "osc1_level": 0.7,
        "osc1_unison": 2,
        "osc1_detune": 6,
        "osc1_spread": 0.5,
        "osc2_on": true,
        "osc2_frame": 0.3,
        "osc2_level": 0.4,
        "osc2_semi": -12,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 1800,
        "filt1_res": 0.15,
        "env1_attack": 0.12,
        "env1_decay": 0.4,
        "env1_sustain": 0.85,
        "env1_release": 0.5,
        "env1_acurve": -0.2,
        "lfo2_rate": 5.0,
        "lfo2_mode": "Free",
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.2,
        "fx_chorus_rate": 0.3,
        "fx_chorus_depth": 0.3,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.3,
        "fx_reverb_size": 0.65,
        "fx_reverb_decay": 3.0,
        "fx_reverb_damp": 0.5
    },
    "modulation": [
        {"source": "LFO 2", "destination": "Osc1 Fine", "depth": 0.03},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.3},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.2},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.0}
    ]
}
