{
    "name": "Moon Drop",
    "category": "Bass",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A long, dramatic pitch fall between notes: a mono bass with a slow glide on every note, so each line swoops into place. Great for one-note rolls and big breakdown moves; shorten the Glide knob for a subtler slur.",
    "tags": ["bass", "glide", "portamento", "mono", "swoop", "breakdown"],
    "macro_names": ["Brightness", "Morph", "Grit", "Sub"],
    "parameters": {
        "master_volume": -2.8,
        "osc1_on": true,
        "osc1_table": "Digital Bass",
        "osc1_frame": 0.35,
        "osc1_level": 0.8,
        "osc2_on": true,
        "osc2_table": "Sine Harmonics",
        "osc2_frame": 0.2,
        "osc2_level": 0.3,
        "osc2_semi": -12,
        "sub_level": 0.45,
        "sub_wave": "Sine",
        "sub_oct": "-1 Oct",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 520,
        "filt1_res": 0.22,
        "filt1_drive": 0.1,
        "filt1_slope": "24 dB",
        "env1_attack": 0.003,
        "env1_decay": 0.35,
        "env1_sustain": 0.85,
        "env1_release": 0.25,
        "voice_mode": "Mono",
        "glide_time": 0.55,
        "fx_dist_on": true,
        "fx_dist_type": "Soft",
        "fx_dist_drive": 0.2,
        "fx_dist_tone": 0.5,
        "fx_dist_mix": 0.3,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.08,
        "fx_reverb_size": 0.4,
        "fx_reverb_decay": 1.5,
        "fx_reverb_damp": 0.6
    },
    "modulation": [
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Macro 3", "destination": "Dist Drive", "depth": 0.5},
        {"source": "Macro 4", "destination": "Sub Level", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.2},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.0},
        {"source": "Aftertouch", "destination": "Dist Mix", "depth": 0.1}
    ]
}
