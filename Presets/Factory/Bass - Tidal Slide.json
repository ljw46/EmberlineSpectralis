{
    "name": "Tidal Slide",
    "category": "Bass",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "The pitch-slide bassline: a mono, legato sub that glides between notes that overlap and stays tight on the ones that don't. Hold a note, play the next, and it slides home. Play it long and slow under a breakdown.",
    "tags": ["bass", "glide", "portamento", "mono", "legato", "melodic house"],
    "macro_names": ["Brightness", "Morph", "Grit", "Sub"],
    "parameters": {
        "master_volume": -1.6,
        "osc1_on": true,
        "osc1_table": "Bass Weight",
        "osc1_frame": 0.3,
        "osc1_level": 0.8,
        "osc2_on": true,
        "osc2_table": "Classic Morph",
        "osc2_frame": 0.5,
        "osc2_level": 0.3,
        "osc2_semi": -12,
        "osc2_pan": 0.08,
        "sub_level": 0.4,
        "sub_wave": "Sine",
        "sub_oct": "-1 Oct",
        "filt1_type": "Ladder",
        "filt1_cutoff": 420,
        "filt1_res": 0.3,
        "filt1_drive": 0.12,
        "filt1_slope": "24 dB",
        "env1_attack": 0.004,
        "env1_decay": 0.4,
        "env1_sustain": 0.9,
        "env1_release": 0.2,
        "env2_attack": 0.001,
        "env2_decay": 0.3,
        "env2_sustain": 0.2,
        "env2_release": 0.2,
        "env2_dcurve": 0.5,
        "voice_mode": "Legato",
        "glide_time": 0.28,
        "glide_mode": "Legato Only",
        "fx_dist_on": true,
        "fx_dist_type": "Tube",
        "fx_dist_drive": 0.22,
        "fx_dist_tone": 0.45,
        "fx_dist_mix": 0.4,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.06,
        "fx_reverb_size": 0.35,
        "fx_reverb_decay": 1.2,
        "fx_reverb_damp": 0.6
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Filt1 Cutoff", "depth": 0.17},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Macro 3", "destination": "Dist Drive", "depth": 0.5},
        {"source": "Macro 4", "destination": "Sub Level", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.18},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.2},
        {"source": "Aftertouch", "destination": "Dist Mix", "depth": 0.1}
    ]
}
