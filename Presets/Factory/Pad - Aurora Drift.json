{
    "name": "Aurora Drift",
    "category": "Pad",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A slowly shifting wash of recorded voice, detuned waves and a thin glitter of glass harmonics. Three different movements run at once - filter, wave position and stereo drift - so it never repeats.",
    "tags": ["pad", "voice", "evolving", "wide", "melodic house"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": 2.6,
        "osc1_on": true,
        "osc1_table": "Human Voice",
        "osc1_frame": 0.3,
        "osc1_level": 0.65,
        "osc1_unison": 4,
        "osc1_detune": 13,
        "osc1_spread": 0.9,
        "osc1_pan": -0.2,
        "osc2_on": true,
        "osc2_table": "Blended Waves",
        "osc2_frame": 0.4,
        "osc2_level": 0.5,
        "osc2_unison": 4,
        "osc2_detune": 15,
        "osc2_spread": 0.9,
        "osc2_semi": 7,
        "osc2_pan": 0.2,
        "osc3_on": true,
        "osc3_table": "Glass Harmonics",
        "osc3_frame": 0.5,
        "osc3_level": 0.2,
        "osc3_unison": 2,
        "osc3_detune": 8,
        "osc3_spread": 0.5,
        "osc3_semi": 12,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 2600,
        "filt1_res": 0.2,
        "env1_attack": 1.1,
        "env1_decay": 1.0,
        "env1_sustain": 0.85,
        "env1_release": 2.4,
        "lfo1_rate": 0.07,
        "lfo1_mode": "Free",
        "lfo2_rate": 0.13,
        "lfo2_mode": "Free",
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.3,
        "fx_chorus_rate": 0.3,
        "fx_chorus_depth": 0.55,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.4,
        "fx_reverb_size": 0.8,
        "fx_reverb_decay": 6.0,
        "fx_reverb_damp": 0.4,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.4,
        "fx_delay_tone": 3800,
        "fx_delay_mix": 0.18,
        "fx_delay_sync": "1/4."
    },
    "modulation": [
        {"source": "LFO 1", "destination": "Filt1 Cutoff", "depth": 0.12},
        {"source": "Perlin", "destination": "Osc1 Frame", "depth": 0.3},
        {"source": "LFO 2", "destination": "Osc2 Frame", "depth": 0.25},
        {"source": "Chaos X", "destination": "Osc1 Pan", "depth": 0.4},
        {"source": "Chaos Y", "destination": "Osc2 Pan", "depth": 0.4},
        {"source": "Perlin", "destination": "Osc3 Level", "depth": 0.15},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc2 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.1},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Aftertouch", "destination": "Osc2 Frame", "depth": 0.2}
    ]
}
