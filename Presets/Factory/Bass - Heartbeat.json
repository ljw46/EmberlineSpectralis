{
    "name": "Heartbeat",
    "category": "Bass",
    "description": "A deep, thumping sub with a quick downward pitch drop on every note - half bass, half kick. Short notes make a pulse, long notes a boom.",
    "tags": ["bass", "sub", "thump", "808", "kick-like"],
    "macro_names": ["Brightness", "Morph", "Grit", "Sub"],
    "parameters": {
        "master_volume": -1.3,
        "osc1_on": true,
        "osc1_table": "Bass Weight",
        "osc1_frame": 0.2,
        "osc1_level": 0.9,
        "sub_level": 0.55,
        "sub_wave": "Sine",
        "sub_oct": "-1 Oct",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 320,
        "filt1_res": 0.1,
        "env1_attack": 0.002,
        "env1_decay": 0.9,
        "env1_sustain": 0.0,
        "env1_release": 0.3,
        "env1_dcurve": 0.35,
        "env2_attack": 0.001,
        "env2_decay": 0.09,
        "env2_sustain": 0.0,
        "env2_release": 0.05,
        "env2_dcurve": 0.7,
        "fx_dist_on": true,
        "fx_dist_type": "Soft",
        "fx_dist_drive": 0.3,
        "fx_dist_tone": 0.35,
        "fx_dist_mix": 0.4
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Osc1 Fine", "depth": -0.9, "bipolar": false},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.3},
        {"source": "Macro 3", "destination": "Dist Drive", "depth": 0.5},
        {"source": "Macro 4", "destination": "Sub Level", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.12},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.2},
        {"source": "Aftertouch", "destination": "Dist Mix", "depth": 0.12}
    ]
}
