        "osc1_spread": 0.5,
        "osc2_on": true,
        "osc2_frame": 0.0,
        "osc2_level": 0.3,
        "osc2_semi": 12,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 3800,
        "filt1_res": 0.25,
        "env1_attack": 0.001,
        "env1_decay": 0.2,
        "env1_sustain": 0.0,
        "env1_release": 0.14,
        "env1_dcurve": 0.5,
        "env2_attack": 0.001,
        "env2_decay": 0.15,
        "env2_sustain": 0.0,
        "env2_release": 0.1,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.4,
        "fx_delay_tone": 6000,
        "fx_delay_mix": 0.25,
        "fx_delay_sync": "1/8.",
