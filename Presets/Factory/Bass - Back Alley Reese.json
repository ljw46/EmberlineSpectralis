{
    "name": "Back Alley Reese",
    "category": "Bass",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A classic dark reese: two blended-wave oscillators detuned against each other so the low end phases and growls, with the filter creeping slowly.",
    "tags": ["bass", "reese", "dark", "detuned"],
    "macro_names": ["Brightness", "Morph", "Grit", "Sub"],
    "parameters": {
        "master_volume": -2.7,
        "osc1_on": true,
        "osc1_table": "Blended Waves",
        "osc1_frame": 0.45,
        "osc1_level": 0.7,
        "osc1_unison": 2,
        "osc1_detune": 28,
        "osc1_spread": 0.35,
        "osc1_pan": -0.12,
        "osc2_on": true,
        "osc2_table": "Blended Waves",
        "osc2_frame": 0.55,
        "osc2_level": 0.6,
        "osc2_unison": 2,
        "osc2_detune": 24,
        "osc2_spread": 0.35,
        "osc2_fine": 9,
        "osc2_pan": 0.12,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 480,
        "filt1_res": 0.22,
        "filt1_drive": 0.15,
        "env1_attack": 0.004,
        "env1_decay": 0.3,
        "env1_sustain": 0.88,
        "env1_release": 0.2,
        "lfo1_rate": 0.18,
        "lfo1_mode": "Free",
        "lfo2_rate": 0.07,
        "lfo2_mode": "Free",
        "fx_dist_on": true,
        "fx_dist_type": "Soft",
        "fx_dist_drive": 0.3,
        "fx_dist_tone": 0.45,
        "fx_dist_mix": 0.5,
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.2,
        "fx_chorus_rate": 0.3,
        "fx_chorus_depth": 0.45
    },
    "modulation": [
        {"source": "LFO 1", "destination": "Filt1 Cutoff", "depth": 0.08},
        {"source": "LFO 2", "destination": "Osc1 Frame", "depth": 0.2},
        {"source": "LFO 2", "destination": "Osc2 Frame", "depth": -0.2},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Macro 3", "destination": "Dist Drive", "depth": 0.5},
        {"source": "Macro 4", "destination": "Sub Level", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.16},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.25},
        {"source": "Aftertouch", "destination": "Dist Mix", "depth": 0.12}
    ]
}
