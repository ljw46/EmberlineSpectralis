{
    "name": "Square Pluck",
    "category": "Pluck",
    "description": "Retro square-wave pluck with a clean, buzzy bite. Short and tight.",
    "tags": ["pluck", "square", "retro", "tight"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": 0.7,
        "osc1_on": true,
