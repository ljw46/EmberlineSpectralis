        "osc1_level": 0.75,
        "osc1_unison": 2,
        "osc1_detune": 6,
        "osc1_spread": 0.5,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 1500,
        "filt1_res": 0.3,
        "env1_attack": 0.001,
        "env1_decay": 0.3,
        "env1_sustain": 0.0,
        "env1_release": 0.15,
        "env1_dcurve": 0.5,
        "env2_attack": 0.001,
        "env2_decay": 0.2,
        "env2_sustain": 0.0,
        "env2_release": 0.1,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.3,
        "fx_delay_tone": 5000,
        "fx_delay_mix": 0.2,
        "fx_delay_sync": "1/8"
