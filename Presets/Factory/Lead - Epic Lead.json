{
    "name": "Epic Lead",
    "category": "Lead",
    "description": "Anthemic lead stack with detune, octave layer, delay and a huge reverb. Built for the big drop.",
    "tags": ["lead", "epic", "anthemic", "big"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": 0.9,
        "osc1_on": true,
        "osc1_frame": 0.5,
        "osc1_level": 0.65,
        "osc1_unison": 4,
        "osc1_detune": 18,
        "osc1_spread": 0.8,
        "osc2_on": true,
        "osc2_frame": 0.62,
        "osc2_level": 0.45,
        "osc2_unison": 3,
        "osc2_detune": 14,
        "osc2_spread": 0.7,
        "osc2_semi": 12,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 5500,
        "filt1_res": 0.2,
        "env1_attack": 0.012,
        "env1_decay": 0.35,
        "env1_sustain": 0.8,
        "env1_release": 0.5,
        "lfo2_rate": 5.2,
        "lfo2_mode": "Free",
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.25,
        "fx_chorus_rate": 0.4,
        "fx_chorus_depth": 0.5,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.4,
        "fx_delay_tone": 5000,
        "fx_delay_mix": 0.28,
        "fx_delay_sync": "1/4",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.35,
        "fx_reverb_size": 0.8,
        "fx_reverb_decay": 5.0,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "LFO 2", "destination": "Osc1 Fine", "depth": 0.025},
        {"source": "LFO 2", "destination": "Osc2 Fine", "depth": 0.025},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.3},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5}
    ]
}
