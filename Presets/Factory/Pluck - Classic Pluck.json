        "filt1_res": 0.25,
        "env1_attack": 0.002,
        "env1_decay": 0.45,
        "env1_sustain": 0.0,
        "env1_release": 0.25,
        "env1_dcurve": 0.5,
        "env2_attack": 0.001,
        "env2_decay": 0.35,
        "env2_sustain": 0.0,
