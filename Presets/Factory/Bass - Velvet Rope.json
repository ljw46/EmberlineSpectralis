{
    "name": "Velvet Rope",
    "category": "Bass",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A low bowed-cello bass: soft attack, woody and human. Plays beautifully under slow chords; lean on the wheel for more bow pressure.",
    "tags": ["bass", "cello", "bowed", "organic", "slow"],
    "macro_names": ["Brightness", "Morph", "Grit", "Sub"],
    "parameters": {
        "master_volume": -0.6,
        "osc1_on": true,
        "osc1_table": "Cello",
        "osc1_frame": 0.15,
        "osc1_level": 0.85,
        "osc1_unison": 2,
        "osc1_detune": 5,
        "osc1_spread": 0.5,
        "osc2_on": true,
        "osc2_table": "Brass Swell",
        "osc2_frame": 0.1,
        "osc2_level": 0.3,
        "osc2_semi": -12,
        "sub_level": 0.3,
        "sub_wave": "Sine",
        "sub_oct": "-1 Oct",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 700,
        "filt1_res": 0.15,
        "env1_attack": 0.05,
        "env1_decay": 0.5,
        "env1_sustain": 0.85,
        "env1_release": 0.3,
        "env1_acurve": -0.2,
        "lfo2_rate": 4.8,
        "lfo2_mode": "Free",
        "fx_dist_on": true,
        "fx_dist_type": "Tube",
        "fx_dist_drive": 0.15,
        "fx_dist_tone": 0.4,
        "fx_dist_mix": 0.3,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.1,
        "fx_reverb_size": 0.4,
        "fx_reverb_decay": 1.6,
        "fx_reverb_damp": 0.6
    },
    "modulation": [
        {"source": "LFO 2", "destination": "Osc1 Fine", "depth": 0.02},
        {"source": "Aftertouch", "destination": "Osc1 Fine", "depth": 0.025},
        {"source": "Mod Wheel", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Macro 3", "destination": "Dist Drive", "depth": 0.5},
        {"source": "Macro 4", "destination": "Sub Level", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.25},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.2},
        {"source": "Aftertouch", "destination": "Dist Mix", "depth": 0.12}
    ]
}
