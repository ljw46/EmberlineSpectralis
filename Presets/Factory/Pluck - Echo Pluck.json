{
    "name": "Echo Pluck",
    "category": "Pluck",
    "description": "A pluck that blooms into a dotted-eighth ping-pong echo. The echo does the melodic heavy lifting.",
    "tags": ["pluck", "echo", "delay", "melodic house"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": 2.0,
        "osc1_on": true,
        "osc1_frame": 0.45,
        "osc1_level": 0.8,
        "osc1_unison": 2,
        "osc1_detune": 8,
        "osc1_spread": 0.5,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 1200,
        "filt1_res": 0.25,
        "env1_attack": 0.002,
        "env1_decay": 0.4,
        "env1_sustain": 0.0,
        "env1_release": 0.25,
        "env1_dcurve": 0.5,
        "env2_attack": 0.001,
        "env2_decay": 0.3,
        "env2_sustain": 0.0,
        "env2_release": 0.2,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.52,
        "fx_delay_tone": 4500,
        "fx_delay_mix": 0.4,
        "fx_delay_sync": "1/8.",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.2,
        "fx_reverb_size": 0.6,
        "fx_reverb_decay": 3.0,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Filt1 Cutoff", "depth": 0.247},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.4},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5}
    ]
}
