        "osc1_on": true,
        "osc1_table": "Acoustic Guitar",
        "osc1_frame": 0.45,
        "osc1_level": 0.8,
        "osc1_pan": -0.3,
        "osc2_on": true,
        "osc2_table": "Acoustic Guitar",
        "osc2_frame": 0.7,
        "osc2_level": 0.55,
        "osc2_semi": 12,
        "osc2_pan": 0.3,
        "osc3_on": true,
        "osc3_table": "Pluck Position",
