        "osc3_level": 0.2,
        "osc3_semi": 19,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 5200,
        "filt1_res": 0.12,
        "env1_attack": 0.001,
        "env1_decay": 1.1,
        "env1_sustain": 0.0,
        "env1_release": 0.7,
        "env2_attack": 0.001,
        "env2_decay": 0.2,
