{
    "name": "Copper Wire",
    "category": "Pluck",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A taut, metallic string pluck: the pluck-position table with a fast filter pinch, fattened by a bright saw sweep. Percussive and slightly dangerous.",
    "tags": ["pluck", "metallic", "string", "tight"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": 2.1,
        "osc1_on": true,
        "osc1_table": "Pluck Position",
        "osc1_frame": 0.55,
        "osc1_level": 0.85,
        "osc1_unison": 2,
        "osc1_detune": 7,
        "osc1_spread": 0.5,
        "osc1_pan": -0.1,
        "osc2_on": true,
        "osc2_table": "Saw Sweep",
        "osc2_frame": 0.2,
        "osc2_level": 0.35,
        "osc2_unison": 2,
        "osc2_detune": 9,
        "osc2_spread": 0.5,
        "osc2_pan": 0.12,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 1700,
        "filt1_res": 0.3,
        "env1_attack": 0.001,
        "env1_decay": 0.38,
        "env1_sustain": 0.0,
        "env1_release": 0.2,
        "env1_dcurve": 0.55,
        "env2_attack": 0.001,
        "env2_decay": 0.22,
        "env2_sustain": 0.0,
        "env2_release": 0.14,
        "env2_dcurve": 0.6,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.32,
        "fx_delay_tone": 5000,
        "fx_delay_mix": 0.2,
        "fx_delay_sync": "1/8",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.16,
        "fx_reverb_size": 0.45,
        "fx_reverb_decay": 2.0,
        "fx_reverb_damp": 0.5
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Filt1 Cutoff", "depth": 0.256},
        {"source": "ENV 2", "destination": "Osc2 Frame", "depth": 0.5},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.45},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.2},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Aftertouch", "destination": "Osc1 Frame", "depth": 0.2}
    ]
}
