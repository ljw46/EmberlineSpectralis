{
    "name": "Downlifter",
    "category": "FX",
    "description": "The opposite of a riser: noise and tone that sink away as the filter closes. For post-drop tails.",
    "tags": ["fx", "downlifter", "tail", "transition"],
    "macro_names": ["Brightness", "Morph", "Resonance", "-"],
    "parameters": {
        "master_volume": 6.0,
        "osc1_on": true,
        "osc1_frame": 0.5,
        "osc1_level": 0.45,
        "osc1_unison": 4,
        "osc1_detune": 18,
        "osc1_spread": 0.5,
        "noise_level": 0.4,
        "noise_type": "White",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 12000,
        "filt1_res": 0.3,
        "env1_attack": 0.01,
        "env1_decay": 4.0,
        "env1_sustain": 0.0,
        "env1_release": 2.0,
        "env1_dcurve": 0.2,
        "env2_attack": 0.005,
        "env2_decay": 3.5,
        "env2_sustain": 0.0,
        "env2_release": 1.0,
        "env2_dcurve": 0.3,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.3,
        "fx_reverb_size": 0.75,
        "fx_reverb_decay": 4.5,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Filt1 Cutoff", "depth": -0.536},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.3},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.0}
    ]
}
