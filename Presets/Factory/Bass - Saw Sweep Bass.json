{
    "name": "Saw Sweep Bass",
    "category": "Bass",
    "description": "A saw bass that carries its own filter: the Saw Sweep table opens on every note via the envelope - no filter needed.",
    "tags": ["bass", "saw", "sweep", "wavetable"],
    "macro_names": ["Brightness", "Sweep", "Resonance", "-"],
    "parameters": {
        "master_volume": 0.2,
        "osc1_table": "Saw Sweep",
        "osc1_on": true,
        "osc1_frame": 0.1,
        "osc1_level": 0.85,
        "sub_level": 0.35,
        "sub_wave": "Sine",
        "sub_oct": "-1 Oct",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 12000,
        "filt1_res": 0.1,
        "env1_attack": 0.002,
        "env1_decay": 0.3,
        "env1_sustain": 0.7,
        "env1_release": 0.12,
        "env2_attack": 0.001,
        "env2_decay": 0.25,
        "env2_sustain": 0.0,
        "env2_release": 0.2,
        "env2_dcurve": 0.5
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Osc1 Frame", "depth": 0.55},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.2},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.0}
    ]
}
