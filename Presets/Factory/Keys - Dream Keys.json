{
    "name": "Dream Keys",
    "category": "Keys",
    "description": "Hazy, washed-out keys drenched in chorus, delay and reverb. Soft focus.",
    "tags": ["keys", "dreamy", "washed", "hazy"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": 2.5,
        "osc1_on": true,
        "osc1_frame": 0.28,
        "osc1_level": 0.75,
        "osc1_unison": 3,
        "osc1_detune": 10,
        "osc1_spread": 0.8,
        "osc2_on": true,
        "osc2_frame": 0.1,
        "osc2_level": 0.35,
        "osc2_semi": 12,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 3500,
        "filt1_res": 0.12,
        "env1_attack": 0.01,
        "env1_decay": 1.0,
        "env1_sustain": 0.35,
        "env1_release": 1.0,
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.5,
        "fx_chorus_rate": 0.35,
        "fx_chorus_depth": 0.6,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.45,
        "fx_delay_tone": 4500,
        "fx_delay_mix": 0.3,
        "fx_delay_sync": "1/4",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.4,
        "fx_reverb_size": 0.8,
        "fx_reverb_decay": 6.0,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.2},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.4}
    ]
}
