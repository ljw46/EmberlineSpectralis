{
    "name": "Wood Pluck",
    "category": "Pluck",
    "description": "Hollow, woody square pluck with a quick decay. Reminds of a muted wooden mallet.",
    "tags": ["pluck", "wood", "hollow", "organic"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": 5.0,
        "osc1_on": true,
        "osc1_frame": 0.8,
        "osc1_level": 0.8,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 1000,
        "filt1_res": 0.2,
        "env1_attack": 0.001,
        "env1_decay": 0.22,
        "env1_sustain": 0.0,
        "env1_release": 0.12,
        "env1_dcurve": 0.6,
        "env2_attack": 0.001,
        "env2_decay": 0.15,
        "env2_sustain": 0.0,
        "env2_release": 0.1,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.12,
        "fx_reverb_size": 0.35,
        "fx_reverb_decay": 1.2,
        "fx_reverb_damp": 0.4,
        "osc1_table": "Mallet"
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Filt1 Cutoff", "depth": 0.161},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.4},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5}
    ]
}
