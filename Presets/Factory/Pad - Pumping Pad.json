{
    "name": "Pumping Pad",
    "category": "Pad",
    "description": "Sidechain-pumped pad that ducks on every beat (host-synced). Instant four-on-the-floor energy.",
    "tags": ["pad", "sidechain", "pump", "house"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": -3.4,
        "osc1_on": true,
        "osc1_frame": 0.5,
        "osc1_level": 0.65,
        "osc1_unison": 5,
        "osc1_detune": 16,
        "osc1_spread": 0.9,
        "osc2_on": true,
        "osc2_frame": 0.3,
        "osc2_level": 0.45,
        "osc2_unison": 3,
        "osc2_detune": 10,
        "osc2_spread": 0.5,
        "osc2_semi": 12,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 3200,
        "filt1_res": 0.15,
        "env1_attack": 0.3,
        "env1_decay": 1.0,
        "env1_sustain": 0.9,
        "env1_release": 0.9,
        "lfo3_sync": "1/4",
        "lfo3_mode": "Free",
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.3,
        "fx_chorus_rate": 0.3,
        "fx_chorus_depth": 0.5,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.3,
        "fx_reverb_size": 0.7,
        "fx_reverb_decay": 4.0,
        "fx_reverb_damp": 0.4
    },
    "modulation": [
        {"source": "LFO 3", "destination": "Osc1 Level", "depth": 0.5},
        {"source": "LFO 3", "destination": "Osc2 Level", "depth": 0.5},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.2},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5}
    ],
    "lfo_shapes": {"lfo3": "saw_up"}
}
