{
    "name": "Choir Of One",
    "category": "Lead",
    "description": "A single sung voice for a lead: a recorded human-voice table with a formant filter that shapes the vowel. Macro 2 morphs the vowel; aftertouch adds a breath of vibrato.",
    "tags": ["lead", "vocal", "voice", "vowel", "expressive"],
    "macro_names": ["Brightness", "Vowel", "Space", "Width"],
    "parameters": {
        "master_volume": 1.6,
        "osc1_on": true,
        "osc1_table": "Human Voice",
        "osc1_frame": 0.3,
        "osc1_level": 0.85,
        "osc1_unison": 2,
        "osc1_detune": 4,
        "osc1_spread": 0.5,
        "osc1_pan": -0.08,
        "osc2_on": true,
        "osc2_table": "Vowel Sweep",
        "osc2_frame": 0.4,
        "osc2_level": 0.3,
        "osc2_pan": 0.1,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 5000,
        "filt1_res": 0.18,
        "env1_attack": 0.03,
        "env1_decay": 0.3,
        "env1_sustain": 0.85,
        "env1_release": 0.4,
        "lfo2_rate": 5.0,
        "lfo2_mode": "Free",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.3,
        "fx_reverb_size": 0.65,
        "fx_reverb_decay": 3.4,
        "fx_reverb_damp": 0.4,
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.15,
        "fx_chorus_rate": 0.3,
        "fx_chorus_depth": 0.3
    },
    "modulation": [
        {"source": "LFO 2", "destination": "Osc1 Fine", "depth": 0.018},
        {"source": "Aftertouch", "destination": "Osc1 Fine", "depth": 0.025},
        {"source": "Mod Wheel", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Mod Wheel", "destination": "Osc2 Frame", "depth": 0.4},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc2 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.22}
    ]
}
