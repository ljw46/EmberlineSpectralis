{
    "name": "Thumb Piano Hollow",
    "category": "Organic",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A hollow, buzzy thumb-piano with a wooden resonator ring: clarinet and mallet cycles with a little FM bell on top. Tuned, woody and slightly wonky.",
    "tags": ["organic", "kalimba", "thumb piano", "hollow", "wooden"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": -1.3,
        "osc1_on": true,
        "osc1_table": "Clarinet",
        "osc1_frame": 0.25,
        "osc1_level": 0.8,
        "osc1_pan": -0.12,
        "osc2_on": true,
        "osc2_table": "Mallet",
        "osc2_frame": 0.6,
        "osc2_level": 0.4,
        "osc2_semi": 12,
        "osc2_pan": 0.16,
        "osc3_on": true,
        "osc3_table": "FM 1:5 Bell",
        "osc3_frame": 0.15,
        "osc3_level": 0.2,
        "osc3_semi": 19,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 4200,
        "filt1_res": 0.18,
        "env1_attack": 0.001,
        "env1_decay": 0.7,
        "env1_sustain": 0.0,
        "env1_release": 0.4,
        "env2_attack": 0.001,
        "env2_decay": 0.15,
        "env2_sustain": 0.0,
        "env2_release": 0.1,
        "lfo2_rate": 0.4,
        "lfo2_mode": "Free",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.26,
        "fx_reverb_size": 0.6,
        "fx_reverb_decay": 3.0,
        "fx_reverb_damp": 0.45,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.35,
        "fx_delay_tone": 3800,
        "fx_delay_mix": 0.18,
        "fx_delay_sync": "1/8"
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Osc3 Level", "depth": 0.4},
        {"source": "LFO 2", "destination": "Osc1 Fine", "depth": 0.02},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.45},
        {"source": "Macro 2", "destination": "Osc2 Frame", "depth": 0.45},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.2},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Aftertouch", "destination": "Osc1 Frame", "depth": 0.2}
    ]
}
