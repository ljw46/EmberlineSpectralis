{
    "name": "Velvet Clav",
    "category": "Keys",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A funky clavinet with a recorded pluck and a wah-like filter that snaps open with velocity: play softly for a muted chick, hard for a biting slap.",
    "tags": ["keys", "clavinet", "funk", "wah", "dynamic"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": 0.9,
        "osc1_on": true,
        "osc1_table": "Clavinet",
        "osc1_frame": 0.4,
        "osc1_level": 0.85,
        "osc1_pan": -0.1,
        "osc2_on": true,
        "osc2_table": "Pluck Position",
        "osc2_frame": 0.5,
        "osc2_level": 0.3,
        "osc2_semi": 12,
        "osc2_pan": 0.14,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 5200,
        "filt1_res": 0.25,
        "filt1_drive": 0.1,
        "env1_attack": 0.001,
        "env1_decay": 0.3,
        "env1_sustain": 0.0,
        "env1_release": 0.1,
        "env1_dcurve": 0.55,
        "env2_attack": 0.001,
        "env2_decay": 0.2,
        "env2_sustain": 0.0,
        "env2_release": 0.1,
        "fx_dist_on": true,
        "fx_dist_type": "Hard",
        "fx_dist_drive": 0.15,
        "fx_dist_tone": 0.6,
        "fx_dist_mix": 0.3,
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.12,
        "fx_reverb_size": 0.4,
        "fx_reverb_decay": 1.6,
        "fx_reverb_damp": 0.5,
        "fx_delay_on": true,
        "fx_delay_feedback": 0.25,
        "fx_delay_tone": 4000,
        "fx_delay_mix": 0.1,
        "fx_delay_sync": "1/8"
    },
    "modulation": [
        {"source": "ENV 2", "destination": "Filt1 Cutoff", "depth": 0.153},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.35},
        {"source": "Velocity", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Mod Wheel", "destination": "Filt1 Res", "depth": 0.3},
        {"source": "Aftertouch", "destination": "Dist Drive", "depth": 0.3},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.4},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.45},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5}
    ]
}
