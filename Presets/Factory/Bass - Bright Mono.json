{
    "name": "Bright Mono",
    "category": "Bass",
    "description": "Wide, bright bass stack for melodic basslines that need presence. Three detuned saws, lowpassed.",
    "tags": ["bass", "bright", "wide", "stack"],
    "macro_names": ["Brightness", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": 2.6,
        "osc1_on": true,
        "osc1_frame": 0.5,
        "osc1_level": 0.65,
        "osc1_unison": 3,
        "osc1_detune": 14,
        "osc1_spread": 0.35,
        "osc2_on": true,
        "osc2_frame": 0.5,
        "osc2_level": 0.45,
        "osc2_unison": 3,
        "osc2_detune": 18,
        "osc2_spread": 0.35,
        "osc2_semi": -12,
        "sub_level": 0.25,
        "sub_wave": "Sine",
        "sub_oct": "-1 Oct",
        "filt1_type": "Lowpass",
        "filt1_cutoff": 2200,
        "filt1_res": 0.2,
        "env1_attack": 0.003,
        "env1_decay": 0.35,
        "env1_sustain": 0.75,
        "env1_release": 0.15,
        "fx_chorus_on": true,
        "fx_chorus_mix": 0.15,
        "fx_chorus_rate": 0.4,
        "fx_chorus_depth": 0.4
    },
    "modulation": [
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.3},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5}
    ]
}
