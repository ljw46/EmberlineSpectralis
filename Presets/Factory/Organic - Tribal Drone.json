{
    "name": "Tribal Drone",
    "category": "Organic",
    "author": "EmberlineSky",
    "url": "https://www.instagram.com/emberlinesky/",
    "description": "A deep, throbbing drone: a low recorded voice with a sub, a vowel-like formant pulse locked to the half note. Hypnotic, ritualistic and heavy.",
    "tags": ["organic", "tribal", "drone", "hypnotic", "voice", "synced"],
    "macro_names": ["Vowel", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": -3.5,
        "osc1_on": true,
        "osc1_table": "Human Voice",
        "osc1_frame": 0.15,
        "osc1_level": 0.8,
        "osc1_unison": 2,
        "osc1_detune": 7,
        "osc1_spread": 0.5,
        "osc1_semi": -12,
        "osc1_pan": -0.1,
        "osc2_on": true,
        "osc2_table": "Vowel Sweep",
        "osc2_frame": 0.3,
        "osc2_level": 0.4,
        "osc2_unison": 2,
        "osc2_detune": 6,
        "osc2_spread": 0.5,
        "osc2_pan": 0.12,
        "sub_level": 0.35,
        "sub_wave": "Sine",
        "sub_oct": "-1 Oct",
        "filt1_type": "Formant",
        "filt1_cutoff": 450,
        "filt1_res": 0.5,
        "env1_attack": 0.6,
        "env1_decay": 1.0,
        "env1_sustain": 0.9,
        "env1_release": 1.6,
        "lfo1_sync": "1/2",
        "lfo1_mode": "Free",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.32,
        "fx_reverb_size": 0.7,
        "fx_reverb_decay": 3.8,
        "fx_reverb_damp": 0.55
    },
    "modulation": [
        {"source": "LFO 1", "destination": "Filt1 Cutoff", "depth": 0.18},
        {"source": "LFO 1", "destination": "Osc2 Frame", "depth": 0.3},
        {"source": "Perlin", "destination": "Osc1 Frame", "depth": 0.25},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc2 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.1},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Aftertouch", "destination": "Osc2 Level", "depth": 0.25}
    ],
    "lfo_shapes": {"lfo1": "sine"}
}
