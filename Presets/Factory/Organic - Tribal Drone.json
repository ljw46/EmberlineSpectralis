{
    "name": "Tribal Drone",
    "category": "Organic",
    "description": "Low, throbbing drone with a vowel-like filter pulse. A hypnotic, ritualistic bed.",
    "tags": ["organic", "tribal", "drone", "hypnotic"],
    "macro_names": ["Vowel", "Morph", "Resonance", "Width"],
    "parameters": {
        "master_volume": -4.6,
        "osc1_on": true,
        "osc1_frame": 0.4,
        "osc1_level": 0.7,
        "osc1_unison": 2,
        "osc1_detune": 8,
        "osc1_spread": 0.5,
        "sub_level": 0.4,
        "sub_wave": "Sine",
        "sub_oct": "-1 Oct",
        "filt1_type": "Formant",
        "filt1_cutoff": 450,
        "filt1_res": 0.5,
        "env1_attack": 0.6,
        "env1_decay": 1.0,
        "env1_sustain": 0.9,
        "env1_release": 1.5,
        "lfo1_sync": "1/2",
        "lfo1_mode": "Free",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.3,
        "fx_reverb_size": 0.65,
        "fx_reverb_decay": 3.5,
        "fx_reverb_damp": 0.5
    },
    "modulation": [
        {"source": "LFO 1", "destination": "Filt1 Cutoff", "depth": 0.16},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.4},
        {"source": "Macro 3", "destination": "Filt1 Res", "depth": 0.4},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.3}
    ],
    "lfo_shapes": {"lfo1": "sine"}
}
