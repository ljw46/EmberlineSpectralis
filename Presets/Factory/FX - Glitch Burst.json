{
    "name": "Glitch Burst",
    "category": "FX",
    "description": "A short flurry of random stutters: sample-and-hold flicks the wave position, the filter and the pan across a chip-and-snippet table pair, then dissolves into a triplet echo. Instant fill material.",
    "tags": ["fx", "glitch", "stutter", "random", "fill"],
    "macro_names": ["Brightness", "Morph", "Space", "Width"],
    "parameters": {
        "master_volume": 4.1,
        "osc1_on": true,
        "osc1_table": "Chip Oscillators",
        "osc1_frame": 0.5,
        "osc1_level": 0.7,
        "osc1_unison": 2,
        "osc1_detune": 10,
        "osc1_spread": 0.9,
        "osc1_pan": -0.2,
        "osc2_on": true,
        "osc2_table": "Snippets",
        "osc2_frame": 0.5,
        "osc2_level": 0.45,
        "osc2_semi": 12,
        "osc2_pan": 0.2,
        "filt1_type": "Lowpass",
        "filt1_cutoff": 5000,
        "filt1_res": 0.35,
        "env1_attack": 0.002,
        "env1_decay": 0.9,
        "env1_sustain": 0.0,
        "env1_release": 0.5,
        "lfo1_sync": "1/16",
        "lfo1_mode": "Free",
        "fx_delay_on": true,
        "fx_delay_feedback": 0.55,
        "fx_delay_tone": 5500,
        "fx_delay_mix": 0.38,
        "fx_delay_sync": "1/16T",
        "fx_reverb_on": true,
        "fx_reverb_mix": 0.22,
        "fx_reverb_size": 0.5,
        "fx_reverb_decay": 2.4,
        "fx_reverb_damp": 0.4,
        "fx_dist_on": true,
        "fx_dist_type": "Hard",
        "fx_dist_drive": 0.2,
        "fx_dist_tone": 0.55,
        "fx_dist_mix": 0.3
    },
    "modulation": [
        {"source": "S&H", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "S&H", "destination": "Osc2 Frame", "depth": 0.5},
        {"source": "S&H", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "S&H", "destination": "Osc1 Pan", "depth": 0.8},
        {"source": "S&H", "destination": "Osc2 Pan", "depth": -0.8},
        {"source": "Macro 1", "destination": "Filt1 Cutoff", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc1 Frame", "depth": 0.5},
        {"source": "Macro 2", "destination": "Osc2 Frame", "depth": 0.5},
        {"source": "Macro 3", "destination": "Reverb Mix", "depth": 0.38},
        {"source": "Macro 3", "destination": "Delay Mix", "depth": 0.22},
        {"source": "Macro 4", "destination": "Osc1 Detune", "depth": 0.5},
        {"source": "Mod Wheel", "destination": "Filt1 Cutoff", "depth": 0.3},
        {"source": "Aftertouch", "destination": "Reverb Mix", "depth": 0.2},
        {"source": "Velocity", "destination": "Filt1 Cutoff", "depth": 0.1}
    ]
}
